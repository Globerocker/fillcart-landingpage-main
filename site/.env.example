# Copy to .env and fill in. NEVER commit the real .env.

# --- Tracking (GTM loads only when set; Consent Mode v2 defaults to denied) ---
PUBLIC_GTM_ID=

# --- HubSpot contact form (Forms API submission from the browser) ---
PUBLIC_HUBSPOT_PORTAL_ID=
PUBLIC_HUBSPOT_FORM_ID=
PUBLIC_HUBSPOT_REGION=eu1

# --- Fallback form delivery until HubSpot is wired (https://web3forms.com, free) ---
PUBLIC_WEB3FORMS_KEY=

# --- Preview behaviour ---
# Include case studies / partners that are not approved yet (set on Vercel "Preview" env only)
PUBLIC_SHOW_DRAFTS=
# Render TODO callouts (on by default in `npm run dev`)
PUBLIC_SHOW_TODOS=

# --- TinaCMS (visual editor, optional) from https://app.tina.io ---
PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
TINA_BRANCH=main
