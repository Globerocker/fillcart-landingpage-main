---
import '@fontsource-variable/space-grotesk';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '../styles/global.css';
import { SITE, INTEGRATIONS, GTM_READY } from '../config/site.ts';
import Behaviors from '../components/Behaviors.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import type { Lang } from '../i18n/types.ts';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page (e.g. "/" or "/en/") for canonical + og:url. */
  path: string;
  /** Path to the equivalent page in the other language, for hreflang. */
  altPath: string;
  /** Optional JSON-LD graph to inline (Organization / FAQPage / etc.). */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { lang, title, description, path, altPath, schema } = Astro.props;

const canonical = new URL(path, SITE.baseUrl).href;
const dePath = lang === 'de' ? path : altPath;
const enPath = lang === 'en' ? path : altPath;

const gtmId = INTEGRATIONS.gtm.containerId;
const consent = INTEGRATIONS.consent;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- hreflang: DE main, EN under /en/, x-default → DE -->
    <link rel="alternate" hreflang="de" href={new URL(dePath, SITE.baseUrl).href} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, SITE.baseUrl).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(dePath, SITE.baseUrl).href} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fillcart" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/assets/logo-black.png', SITE.baseUrl).href} />

    <link rel="icon" type="image/png" href="/assets/icon-black.png" />
    <meta name="theme-color" content="#0B1B33" />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    {/* Cookie-consent CMP must load BEFORE GTM (DE market = mandatory). */}
    {consent.provider === 'cookiebot' && consent.id && (
      <script
        id="Cookiebot"
        src="https://consent.cookiebot.com/uc.js"
        data-cbid={consent.id}
        data-blockingmode="auto"
        is:inline
      />
    )}
    {consent.provider === 'usercentrics' && consent.id && (
      <script
        id="usercentrics-cmp"
        src="https://web.cmp.usercentrics.eu/ui/loader.js"
        data-settings-id={consent.id}
        is:inline
        async
      />
    )}

    {/* Google Tag Manager — only emitted once a container id is configured. */}
    {GTM_READY && (
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');`} />
    )}
  </head>
  <body>
    {GTM_READY && (
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
    )}
    <slot />
    <WhatsAppFloat lang={lang} />
    <Behaviors />
  </body>
</html>
