---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import type { Locale } from '../config/site.ts';
import { getDict } from '../lib/i18n.ts';
import { localePath } from '../i18n/routes.ts';
import { slugOf, fmtDate, readingTime, related, type InsightEntry } from '../lib/content.ts';
import { articleSchema, breadcrumbSchema } from '../lib/seo.ts';
import ArticleCard from '../components/ArticleCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Todo from '../components/Todo.astro';

interface Props { entry: InsightEntry; headings: MarkdownHeading[]; all: InsightEntry[]; lang: Locale }
const { entry, headings, all, lang } = Astro.props;
const d = getDict(lang);
const s = d.insights;
const { data } = entry;
const slug = slugOf(entry.id);
const base = lang === 'en' ? '/insights' : '/de/insights';
const path = `${base}/${slug}`;
const rt = readingTime(entry.body, data.readingTime);
const toc = headings.filter((h) => h.depth === 2);
const rel = related(all, entry, 3);
const p = (en: string) => localePath(lang, en);
const schema = [
  articleSchema({ title: data.title, description: data.description, path, published: data.publishDate, modified: data.updatedDate, lang, keywords: data.tags, section: s.topics[data.topic] }),
  breadcrumbSchema([{ name: s.hero.eyebrow, path: base }, { name: data.title, path }]),
];
---

<BaseLayout lang={lang} title={data.title} description={data.description} path={path} alt={null} ogType="article" ogImage={`/og/insight-${slug}.png`} schema={schema}>
  <section class="art-hero bg-dark bg-lines">
    <div class="wrap">
      <div class="art-hero-in">
        <nav class="crumbs mono" aria-label="Breadcrumb"><a href={base}>{s.hero.eyebrow}</a><span>/</span><span>{s.topics[data.topic] ?? data.topic}</span></nav>
        <h1 class="h1" data-reveal>{data.title}</h1>
        <p class="lead text-muted" data-reveal style="--d:60ms">{data.description}</p>
        <div class="art-meta mono" data-reveal style="--d:120ms">
          <span>{s.article.by} {data.author}</span><span>·</span>
          <time datetime={data.publishDate.toISOString()}>{fmtDate(data.publishDate, d.locale)}</time><span>·</span>
          <span>{rt} {d.common.minRead}</span>
          {data.updatedDate && <><span>·</span><span>{s.article.updated} {fmtDate(data.updatedDate, d.locale)}</span></>}
        </div>
        {data.heroStat && (
          <div class="stat art-stat" data-reveal style="--d:160ms"><div class="stat-num">{data.heroStat.value}</div><div class="stat-label">{data.heroStat.label}</div></div>
        )}
      </div>
    </div>
  </section>

  <div class="progress" aria-hidden="true"><span data-progress></span></div>

  <section class="section-sm">
    <div class="wrap art-grid">
      <aside class="art-aside">
        {toc.length > 0 && (
          <nav class="toc" aria-label={s.article.contents}>
            <div class="eyebrow">{s.article.contents}</div>
            <ul>{toc.map((h) => <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}</ul>
          </nav>
        )}
      </aside>
      <article class="prose art-body">
        {data.draft && <Todo>Draft article. Set draft: false to publish.</Todo>}
        <slot />
        <div class="author">
          <div class="author-name">{s.article.author.name}</div>
          <p>{s.article.author.text}</p>
          <a href={p('/about')} class="link">{s.article.author.cta} →</a>
        </div>
      </article>
    </div>
  </section>

  {rel.length > 0 && (
    <section class="section bg-dots">
      <div class="wrap">
        <h2 class="h2 rel-title">{s.article.related}</h2>
        <div class="grid-3">{rel.map((r, i) => <ArticleCard entry={r} lang={lang} style={`--d:${i * 60}ms`} />)}</div>
      </div>
    </section>
  )}

  <CtaBand lang={lang} title={s.cta.h2} text={s.cta.text} primary={{ label: s.cta.primary, href: p('/services/audit') }} secondary={{ label: s.cta.secondary, href: undefined }} location="article" />
</BaseLayout>

<style>
  .art-hero { padding: clamp(48px, 7vw, 88px) 0 clamp(40px, 6vw, 72px); }
  .art-hero-in { max-width: 820px; display: grid; gap: 16px; }
  .art-hero .lead { margin: 0; }
  .crumbs { display: flex; gap: 10px; font-size: 12px; letter-spacing: .04em; color: var(--color-gray-2); text-transform: uppercase; }
  .crumbs a:hover { color: #fff; }
  .art-meta { display: flex; flex-wrap: wrap; gap: 8px; font-size: 12px; color: var(--color-gray-2); }
  .art-stat { max-width: 420px; margin-top: 8px; }
  .progress { position: sticky; top: 72px; z-index: 40; height: 3px; }
  .progress span { display: block; height: 100%; width: 0; background: var(--color-green); transition: width .1s linear; }
  .art-grid { display: grid; gap: 32px; align-items: start; }
  @media (min-width: 1024px) { .art-grid { grid-template-columns: 240px minmax(0, 760px); gap: 56px; } .art-aside { position: sticky; top: 100px; } }
  .toc ul { list-style: none; padding: 0; margin: 10px 0 0; display: grid; gap: 6px; border-left: 2px solid var(--color-line); }
  .toc a { display: block; padding: 4px 0 4px 12px; font-size: 14px; color: var(--color-gray); border-left: 2px solid transparent; margin-left: -2px; }
  .toc a:hover, .toc a.active { color: var(--color-green); border-left-color: var(--color-green); }
  .author { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--color-line); }
  .author-name { font-family: var(--font-head); font-weight: 600; }
  .author p { margin: 6px 0 10px; color: var(--color-gray); font-size: 15px; }
  .rel-title { margin-bottom: 24px; }
  .grid-3 { display: grid; gap: 16px; }
  @media (min-width: 768px) { .grid-3 { grid-template-columns: repeat(3, 1fr); } }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const body = document.querySelector<HTMLElement>('.art-body');
  const onScroll = () => {
    if (!bar || !body) return;
    const rect = body.getBoundingClientRect();
    const total = body.scrollHeight - window.innerHeight;
    bar.style.width = Math.min(1, Math.max(0, -rect.top / Math.max(1, total))) * 100 + '%';
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
  const targets = links.map((l) => document.getElementById(l.dataset.toc!)).filter((x): x is HTMLElement => !!x);
  if (targets.length && 'IntersectionObserver' in window) {
    const spy = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) links.forEach((l) => l.classList.toggle('active', l.dataset.toc === en.target.id)); });
    }, { rootMargin: '-90px 0px -70% 0px' });
    targets.forEach((t) => spy.observe(t));
  }
</script>
