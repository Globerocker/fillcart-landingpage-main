---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { de } from '../i18n/de.ts';
import { SITE } from '../config/site.ts';
import { CATEGORIES, fmtDate, readingTime, relatedPosts } from '../lib/blog.ts';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Props {
  entry: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  allPosts: CollectionEntry<'blog'>[];
  bodyText?: string;
}
const { entry, headings, allPosts, bodyText } = Astro.props;
const { data } = entry;
const cat = CATEGORIES[data.category];
const rt = readingTime(bodyText, data.readingTime);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const related = relatedPosts(allPosts, entry, 3);
const url = `/wissen/${data.category}/${entry.id.replace(/^.*\//, '')}/`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: data.title,
      description: data.description,
      datePublished: data.publishDate.toISOString(),
      dateModified: (data.updatedDate ?? data.publishDate).toISOString(),
      author: { '@type': 'Person', name: data.author },
      publisher: {
        '@type': 'Organization',
        name: SITE.company.legalName,
        logo: { '@type': 'ImageObject', url: new URL('/assets/brand/logo-black.png', SITE.baseUrl).href },
      },
      mainEntityOfPage: new URL(url, SITE.baseUrl).href,
      articleSection: cat.label,
      keywords: data.tags.join(', '),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Wissen', item: new URL('/wissen/', SITE.baseUrl).href },
        { '@type': 'ListItem', position: 2, name: cat.label, item: new URL(`/wissen/${cat.key}/`, SITE.baseUrl).href },
        { '@type': 'ListItem', position: 3, name: data.title, item: new URL(url, SITE.baseUrl).href },
      ],
    },
  ],
};
---

<BaseLayout lang="de" title={`${data.title} | Fillcart`} description={data.description} path={url} schema={schema}>
  <Header content={de} />

  <div class="reading-progress"><span id="reading-bar"></span></div>

  <main class="art">
    <!-- HERO -->
    <section class="art-hero" style={`--accent:${cat.accent}`}>
      <div class="art-hero-glow"></div>
      <div class="art-hero-mesh"></div>
      <div class="art-hero-inner">
        <nav class="art-crumbs" aria-label="Breadcrumb">
          <a href="/wissen/">Wissen</a>
          <span>›</span>
          <a href={`/wissen/${cat.key}/`}>{cat.label}</a>
        </nav>
        <span class="art-cat" style={`--accent:${cat.accent}`}>{cat.label}</span>
        <h1 class="art-title">{data.title}</h1>
        <p class="art-desc">{data.description}</p>
        <div class="art-meta">
          <span class="art-author"><img src="/assets/team/andre.png" alt="" width="34" height="34" />{data.author}</span>
          <span class="art-dot">·</span>
          <time datetime={data.publishDate.toISOString()}>{fmtDate(data.publishDate)}</time>
          <span class="art-dot">·</span>
          <span>{rt} Min. Lesezeit</span>
        </div>
      </div>
    </section>

    <!-- BODY + TOC -->
    <section class="art-body-wrap">
      <div class="art-grid">
        <aside class="art-toc-col">
          <div class="art-toc" data-toc>
            <div class="art-toc-title">Inhalt</div>
            <details class="art-toc-mobile-wrap" open>
              <summary class="art-toc-mobile-summary">Inhaltsverzeichnis</summary>
              <nav>
                <ul>
                  {toc.map((h) => (
                    <li class={h.depth === 3 ? 'lvl3' : 'lvl2'}>
                      <a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            </details>
            <a href="#audit-cta" class="art-toc-cta">Kostenlosen Audit sichern →</a>
          </div>
        </aside>

        <article class="article-body">
          <slot />

          <!-- End CTA -->
          <div class="art-endcta" id="audit-cta" style={`--accent:${cat.accent}`}>
            <div class="art-endcta-inner">
              <h3>Vom Lesen zum Pipeline-Wachstum.</h3>
              <p>Wir nehmen dein Google-Ads-Konto auseinander — kostenlos, ehrlich, mit Zahlen. Danach weißt du, wo Pipeline liegen bleibt.</p>
              <div class="art-endcta-actions">
                <a href="/#audit" class="art-btn-primary">Kostenlosen Audit sichern</a>
                <a href="/#rechner" class="art-btn-ghost">ROI durchrechnen →</a>
              </div>
            </div>
          </div>

          <!-- Author box -->
          <div class="art-authorbox">
            <img src="/assets/team/andre.png" alt="Andre Schüler" width="72" height="72" />
            <div>
              <div class="art-authorbox-name">{data.author}</div>
              <p>Operator hinter Fillcart. Vorher Head of Marketing bei einer Legal-Tech-SaaS-Holding, Head of SEO bei Matrix42, HubSpot Consultant. Baut Google-Ads-Kampagnen, die auf Pipeline optimieren — nicht auf den billigsten Klick.</p>
              <a href="/ueber-fillcart">Mehr über Fillcart →</a>
            </div>
          </div>
        </article>
      </div>
    </section>

    {related.length > 0 && (
      <section class="art-related">
        <div class="art-related-inner">
          <h2>Weiterlesen</h2>
          <div class="art-related-grid">
            {related.map((p) => <ArticleCard entry={p} />)}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer content={de} />
</BaseLayout>

<script>
  // Reading progress
  const bar = document.getElementById('reading-bar');
  const article = document.querySelector('.article-body');
  const onScroll = () => {
    if (!bar || !article) return;
    const rect = article.getBoundingClientRect();
    const total = article.scrollHeight - window.innerHeight;
    const scrolled = Math.min(1, Math.max(0, -rect.top / Math.max(1, total)));
    bar.style.width = scrolled * 100 + '%';
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ToC scrollspy
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  const ids = links.map((l) => l.getAttribute('data-toc-link')!).filter(Boolean);
  const targets = ids
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => !!el);
  if (targets.length && 'IntersectionObserver' in window) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) {
            const id = en.target.id;
            links.forEach((l) => l.classList.toggle('active', l.getAttribute('data-toc-link') === id));
          }
        });
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );
    targets.forEach((t) => spy.observe(t));
  }
</script>

<style>
  /* Reading progress */
  .reading-progress { position: sticky; top: 74px; z-index: 40; height: 3px; background: transparent; }
  .reading-progress span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--orange), var(--green)); transition: width .1s linear; }

  /* Hero */
  .art-hero { background: #0b1b33; position: relative; overflow: hidden; padding: 56px 32px 48px; }
  .art-hero-glow { position: absolute; top: -160px; right: -120px; width: 560px; height: 560px; background: radial-gradient(circle, color-mix(in srgb, var(--accent) 22%, transparent), transparent 64%); pointer-events: none; }
  .art-hero-mesh { position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px); background-size: 54px 54px; -webkit-mask-image: radial-gradient(circle at 25% 40%, #000, transparent 78%); mask-image: radial-gradient(circle at 25% 40%, #000, transparent 78%); }
  .art-hero-inner { max-width: 820px; margin: 0 auto; position: relative; }
  .art-crumbs { display: flex; gap: 8px; align-items: center; color: #64748b; font-size: 13px; margin-bottom: 16px; }
  .art-crumbs a { color: #94a3b8; }
  .art-crumbs a:hover { color: #fff; }
  .art-cat { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); padding: 5px 12px; border-radius: 999px; }
  .art-title { font-family: var(--font-head); font-weight: 700; color: #fff; font-size: 40px; line-height: 1.12; letter-spacing: -0.02em; margin: 16px 0 0; }
  .art-desc { color: #94a3b8; font-size: 18px; line-height: 1.6; margin: 16px 0 0; }
  .art-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 22px; color: #94a3b8; font-size: 14px; }
  .art-author { display: flex; align-items: center; gap: 9px; color: #e2e8f0; font-weight: 600; }
  .art-author img { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; object-position: top; background: #12233f; }
  .art-dot { color: #475569; }

  /* Body + ToC grid */
  .art-body-wrap { padding: 48px 32px 20px; }
  .art-grid { max-width: 1080px; margin: 0 auto; display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 48px; align-items: start; }
  .art-toc-col { position: sticky; top: 96px; }
  .art-toc { border-left: 2px solid var(--border); padding-left: 18px; }
  .art-toc-title { font-family: var(--font-head); font-weight: 700; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--slate-500); margin-bottom: 12px; }
  .art-toc-mobile-wrap { border: none; }
  .art-toc-mobile-summary { display: none; }
  .art-toc ul { list-style: none; margin: 0; padding: 0; }
  .art-toc li { margin: 0 0 3px; }
  .art-toc li.lvl3 { padding-left: 14px; }
  .art-toc a { display: block; color: var(--slate-500); font-size: 13.5px; line-height: 1.4; padding: 5px 0; border-left: 2px solid transparent; margin-left: -20px; padding-left: 18px; transition: color .2s, border-color .2s; }
  .art-toc a:hover { color: var(--navy); }
  .art-toc a.active { color: var(--accent); border-left-color: var(--accent); font-weight: 600; }
  .art-toc-cta { display: inline-block; margin-top: 18px; font-size: 13.5px; font-weight: 600; color: var(--orange); }

  /* End CTA */
  .art-endcta { margin: 48px 0 0; border-radius: 20px; overflow: hidden; background: linear-gradient(135deg, #0B1B33, #12233f); border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); }
  .art-endcta-inner { padding: 34px 34px; }
  .art-endcta h3 { font-family: var(--font-head); font-weight: 700; font-size: 24px; color: #fff; margin: 0; }
  .art-endcta p { color: #94a3b8; font-size: 16px; line-height: 1.6; margin: 12px 0 0; max-width: 520px; }
  .art-endcta-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .art-btn-primary { background: var(--orange); color: #fff !important; font-weight: 600; font-size: 15px; padding: 13px 22px; border-radius: 12px; box-shadow: 0 12px 26px -8px rgba(249,115,22,.6); }
  .art-btn-primary:hover { background: var(--orange-hover); }
  .art-btn-ghost { color: #e2e8f0 !important; font-weight: 600; font-size: 15px; padding: 13px 20px; border-radius: 12px; border: 1px solid rgba(255,255,255,.18); }
  .art-btn-ghost:hover { border-color: rgba(255,255,255,.4); }

  /* Author box */
  .art-authorbox { display: flex; gap: 18px; align-items: flex-start; margin: 34px 0 0; padding: 26px; background: var(--bg-alt); border: 1px solid var(--border); border-radius: 18px; }
  .art-authorbox img { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; object-position: top; flex-shrink: 0; background: #fff; }
  .art-authorbox-name { font-family: var(--font-head); font-weight: 700; font-size: 18px; color: var(--navy); }
  .art-authorbox p { color: var(--slate-600); font-size: 14.5px; line-height: 1.6; margin: 6px 0 10px; }
  .art-authorbox a { font-weight: 600; font-size: 14px; }

  /* Related */
  .art-related { padding: 20px 32px 84px; }
  .art-related-inner { max-width: 1080px; margin: 0 auto; }
  .art-related-inner h2 { font-family: var(--font-head); font-weight: 700; font-size: 24px; color: var(--navy); margin: 0 0 22px; }
  .art-related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

  @media (max-width: 900px) {
    .art-grid { grid-template-columns: 1fr; gap: 0; }
    .art-toc-col { position: static; margin-bottom: 8px; }
    .art-toc { border-left: none; padding-left: 0; background: var(--bg-alt); border: 1px solid var(--border); border-radius: 14px; padding: 4px 18px 14px; }
    .art-toc-title { display: none; }
    .art-toc-mobile-summary { display: block; cursor: pointer; font-family: var(--font-head); font-weight: 700; font-size: 15px; color: var(--navy); padding: 14px 0; list-style: none; }
    .art-toc-mobile-summary::-webkit-details-marker { display: none; }
    .art-toc-mobile-summary::after { content: '▾'; float: right; color: var(--slate-400); }
    .art-toc a { margin-left: 0; padding-left: 12px; }
    .art-title { font-size: 30px; }
    .art-related-grid { grid-template-columns: 1fr; }
  }
</style>
