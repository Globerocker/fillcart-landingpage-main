---
import BaseLayout from './BaseLayout.astro';
import { getDict } from '../lib/i18n.ts';
import { slugOf, type WorkEntry } from '../lib/content.ts';
import { breadcrumbSchema } from '../lib/seo.ts';
import CaseCard from '../components/CaseCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Todo from '../components/Todo.astro';

interface Props { entry: WorkEntry; others: WorkEntry[] }
const { entry, others } = Astro.props;
const lang = 'en' as const;
const d = getDict(lang);
const w = d.work;
const { data } = entry;
const slug = slugOf(entry.id);
const path = `/work/${slug}`;
const schema = [breadcrumbSchema([{ name: w.hero.h1, path: '/work' }, { name: data.title, path }])];
const meta = [
  [w.labels.client, data.client],
  [w.labels.industry, data.industry],
  [w.labels.role, data.role],
  [w.labels.period, data.period],
  [w.labels.services, data.services.join(', ')],
  [w.labels.stack, data.stack.join(', ')],
].filter(([, v]) => v);
---

<BaseLayout lang={lang} title={data.title} description={data.summary} path={path} alt={null} ogType="article" ogImage={`/og/work-${slug}.png`} schema={schema} noindex={!data.approved}>
  <section class="cs-hero bg-dark bg-lines">
    <div class="wrap">
      <div class="cs-hero-in">
        <nav class="crumbs mono" aria-label="Breadcrumb"><a href="/work">{w.hero.h1}</a><span>/</span><span>{data.industry}</span></nav>
        <div class="cs-tags">{data.services.map((s) => <span class="tag tag-green">{s}</span>)}{!data.approved && <span class="tag tag-warn">{d.common.draft}</span>}</div>
        <h1 class="h1" data-reveal>{data.title}</h1>
        <p class="lead text-muted" data-reveal style="--d:60ms">{data.summary}</p>
        <dl class="cs-meta" data-reveal style="--d:120ms">
          {meta.map(([k, v]) => <div><dt class="mono">{k}</dt><dd>{v}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>

  {data.metrics.length > 0 && (
    <section class="section-sm bg-dots">
      <div class="wrap">
        <div class="eyebrow" data-reveal>{w.labels.results}</div>
        <div class="cs-metrics">
          {data.metrics.map((m, i) => (
            <div class="stat" data-reveal style={`--d:${i * 60}ms`}>
              <div class="stat-num cs-num">{m.value}</div>
              <div class="stat-label">{m.label}</div>
              {m.definition && <div class="cs-def">{m.definition}</div>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section-sm">
    <div class="wrap">
      <article class="prose cs-body" data-case-body>
        {!data.approved && <Todo>{d.common.draft} Set approved: true in the frontmatter to publish (page is noindex until then).</Todo>}
        <slot />
      </article>
    </div>
  </section>

  {others.length > 0 && (
    <section class="section bg-dots">
      <div class="wrap">
        <h2 class="h2 more-title">{w.labels.more}</h2>
        <div class="grid-3">{others.slice(0, 3).map((o, i) => <CaseCard entry={o} lang={lang} style={`--d:${i * 60}ms`} />)}</div>
      </div>
    </section>
  )}

  <CtaBand lang={lang} title={w.cta.h2} text={w.cta.text} primary={{ label: w.cta.primary }} secondary={{ label: w.cta.secondary }} location="case" />
</BaseLayout>

<style>
  .cs-hero { padding: clamp(48px, 7vw, 88px) 0 clamp(40px, 6vw, 72px); }
  .cs-hero-in { max-width: 860px; display: grid; gap: 16px; }
  .cs-hero .lead { margin: 0; }
  .crumbs { display: flex; gap: 10px; font-size: 12px; letter-spacing: .04em; color: var(--color-gray-2); text-transform: uppercase; }
  .crumbs a:hover { color: #fff; }
  .cs-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .cs-meta { margin: 12px 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px 24px; }
  @media (min-width: 768px) { .cs-meta { grid-template-columns: repeat(3, 1fr); } }
  .cs-meta dt { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--color-accent-2); }
  .cs-meta dd { margin: 4px 0 0; font-size: 15px; color: #e6eae7; }
  .cs-metrics { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 16px; }
  @media (min-width: 900px) { .cs-metrics { grid-template-columns: repeat(4, 1fr); } }
  .cs-num { font-size: clamp(30px, 3.4vw, 42px); }
  .cs-def { margin-top: 6px; font-size: 12.5px; color: var(--color-gray); line-height: 1.45; }
  .cs-body { margin-inline: 0; }
  .more-title { margin-bottom: 24px; }
  .grid-3 { display: grid; gap: 16px; }
  @media (min-width: 768px) { .grid-3 { grid-template-columns: repeat(3, 1fr); } }
</style>

<script>
  const body = document.querySelector<HTMLElement>('[data-case-body]');
  if (body) {
    let fired = false;
    const check = () => {
      if (fired) return;
      const rect = body.getBoundingClientRect();
      const read = (window.innerHeight - rect.top) / Math.max(1, rect.height);
      if (read >= 0.75) { fired = true; (window as any).fcTrack?.('case_study_read', { page_path: location.pathname }); window.removeEventListener('scroll', check); }
    };
    window.addEventListener('scroll', check, { passive: true });
    check();
  }
</script>
