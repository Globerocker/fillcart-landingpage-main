---
interface Props { items: { q: string; a: string }[]; class?: string }
const { items, class: cls = '' } = Astro.props;
---

<div class:list={['faq', cls]}>
  {items.map((it) => (
    <details class="faq-item">
      <summary class="faq-q"><span>{it.q}</span><span class="faq-icon" aria-hidden="true"></span></summary>
      <div class="faq-a"><p>{it.a}</p></div>
    </details>
  ))}
</div>

<style>
  .faq { display: grid; border-top: 1px solid var(--color-line); }
  .faq-item { border-bottom: 1px solid var(--color-line); }
  .faq-q { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 0; font-family: var(--font-head); font-weight: 600; font-size: 18px; }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-icon { position: relative; flex: none; width: 18px; height: 18px; }
  .faq-icon::before, .faq-icon::after { content: ''; position: absolute; background: var(--color-green); left: 50%; top: 50%; transform: translate(-50%, -50%); transition: transform .2s; }
  .faq-icon::before { width: 18px; height: 2px; }
  .faq-icon::after { width: 2px; height: 18px; }
  details[open] .faq-icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq-a { padding: 0 0 20px; max-width: 720px; color: var(--color-gray); }
  .faq-a p { margin: 0; }
</style>
