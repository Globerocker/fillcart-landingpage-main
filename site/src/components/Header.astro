---
import { SITE, type Locale } from '../config/site.ts';
import { getDict } from '../lib/i18n.ts';
import { homePath } from '../i18n/routes.ts';
import Logo from './Logo.astro';

interface Props {
  lang: Locale;
  path: string;
  alt?: string;
}
const { lang, path, alt } = Astro.props;
const d = getDict(lang);
const other: Locale = lang === 'en' ? 'de' : 'en';
const switchHref = alt ?? homePath(other);
const isActive = (href: string) => (href === '/' || href === '/de' ? path === href : path === href || path.startsWith(href + '/'));
---

<header class="hdr" data-header>
  <div class="wrap hdr-in">
    <a href={homePath(lang)} class="hdr-brand" aria-label={SITE.brand.siteName}>
      <Logo size={34} />
      <span class="hdr-word">FILLCART</span>
    </a>

    <nav class="hdr-nav" aria-label="Main">
      {d.nav.items.map((it) => (
        <a href={it.href} class:list={['hdr-link', { active: isActive(it.href) }]} aria-current={isActive(it.href) ? 'page' : undefined}>
          {it.label}
          {it.foreign && <sup class="hdr-sup">{d.nav.foreign}</sup>}
        </a>
      ))}
    </nav>

    <div class="hdr-right">
      <a href={switchHref} class="hdr-lang" lang={other} hreflang={other} aria-label={d.nav.switchLabel} data-track="lang_switch" data-lang={other}>{d.nav.switchShort}</a>
      <a href={SITE.booking} class="btn btn-primary btn-sm hdr-cta" target="_blank" rel="noopener" data-track="cta_book_click" data-location="header">{d.nav.cta}</a>
      <button type="button" class="hdr-burger" aria-expanded="false" aria-controls="mobile-nav" data-nav-toggle>
        <span class="sr-only">{d.nav.menu}</span>
        <span class="hdr-burger-bar"></span><span class="hdr-burger-bar"></span><span class="hdr-burger-bar"></span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hdr-mobile" hidden data-nav-panel>
    <div class="wrap hdr-mobile-in">
      {d.nav.items.map((it) => (
        <a href={it.href} class:list={['hdr-mlink', { active: isActive(it.href) }]}>
          {it.label}{it.foreign && <sup class="hdr-sup">{d.nav.foreign}</sup>}
        </a>
      ))}
      <a href={lang === 'en' ? '/contact' : '/de/kontakt'} class="hdr-mlink">{d.nav.contact}</a>
      <div class="hdr-mobile-actions">
        <a href={SITE.booking} class="btn btn-primary" target="_blank" rel="noopener" data-track="cta_book_click" data-location="mobile-nav">{d.nav.cta}</a>
        <a href={switchHref} class="btn btn-secondary" lang={other} hreflang={other} data-track="lang_switch" data-lang={other}>{d.nav.switchLabel}</a>
      </div>
    </div>
  </div>
</header>

<style>
  .hdr-in { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 72px; }
  .hdr-brand { display: inline-flex; align-items: center; gap: 12px; color: var(--color-ink); }
  .hdr-word { font-family: var(--font-head); font-weight: 700; font-size: 17px; letter-spacing: 0.06em; }
  .hdr-nav { display: none; align-items: center; gap: 4px; }
  .hdr-link { position: relative; font-size: 15px; font-weight: 500; color: var(--color-ink); padding: 8px 12px; border-radius: 4px; transition: color .15s, background .15s; }
  .hdr-link:hover { background: var(--color-light); }
  .hdr-link.active { color: var(--color-green); font-weight: 600; }
  .hdr-sup { font-family: var(--font-mono); font-size: 9px; letter-spacing: .06em; color: var(--color-gray); margin-left: 3px; vertical-align: top; }
  .hdr-right { display: flex; align-items: center; gap: 10px; }
  .hdr-lang { font-family: var(--font-mono); font-size: 12px; letter-spacing: .08em; color: var(--color-gray); padding: 8px 10px; border: 1px solid var(--color-line); border-radius: 4px; }
  .hdr-lang:hover { color: var(--color-ink); border-color: var(--color-ink); }
  .hdr-cta { display: none; }
  .hdr-burger { display: inline-flex; flex-direction: column; justify-content: center; gap: 5px; width: 42px; height: 42px; padding: 10px; background: transparent; border: 1px solid var(--color-line); border-radius: 4px; cursor: pointer; }
  .hdr-burger-bar { display: block; height: 2px; width: 100%; background: var(--color-ink); transition: transform .2s, opacity .2s; }
  .hdr-burger[aria-expanded="true"] .hdr-burger-bar:nth-child(2) { transform: translateY(7px) rotate(45deg); }
  .hdr-burger[aria-expanded="true"] .hdr-burger-bar:nth-child(3) { opacity: 0; }
  .hdr-burger[aria-expanded="true"] .hdr-burger-bar:nth-child(4) { transform: translateY(-7px) rotate(-45deg); }
  .hdr-mobile { border-top: 1px solid var(--color-line); background: #fff; }
  .hdr-mobile-in { display: grid; padding-top: 8px; padding-bottom: 20px; }
  .hdr-mlink { font-family: var(--font-head); font-weight: 600; font-size: 22px; padding: 12px 0; border-bottom: 1px solid var(--color-line); color: var(--color-ink); }
  .hdr-mlink.active { color: var(--color-green); }
  .hdr-mobile-actions { display: grid; gap: 10px; margin-top: 18px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (min-width: 1024px) {
    .hdr-nav { display: flex; }
    .hdr-cta { display: inline-flex; }
    .hdr-burger { display: none; }
    .hdr-mobile { display: none !important; }
  }
</style>
