---
import { SITE, type Locale } from '../../config/site.ts';
import { getDict } from '../../lib/i18n.ts';
import { localePath } from '../../i18n/routes.ts';
import Faq from '../Faq.astro';
import CtaBand from '../CtaBand.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const d = getDict(lang);
const a = d.audit;
const p = (en: string) => localePath(lang, en);
---

<!-- Hero (dark) -->
<section class="au-hero bg-dark bg-lines">
  <div class="wrap">
    <div class="au-hero-in">
      <div class="eyebrow" data-reveal>{a.hero.eyebrow}</div>
      <h1 class="display" data-reveal style="--d:60ms">{a.hero.h1}</h1>
      <p class="au-sub" data-reveal style="--d:120ms">{a.hero.sub}</p>
      <p class="au-text text-muted" data-reveal style="--d:160ms">{a.hero.text}</p>
      <div class="au-facts">
        {a.hero.facts.map((f, i) => (
          <div class="stat" data-reveal style={`--d:${180 + i * 60}ms`}>
            <div class="stat-num au-fact-num">{f.value}</div>
            <div class="stat-label">{f.label}</div>
          </div>
        ))}
      </div>
      <div class="au-actions" data-reveal style="--d:300ms">
        <a href={SITE.booking} class="btn btn-light btn-lg" target="_blank" rel="noopener" data-track="cta_book_click" data-location="audit-hero">{a.hero.cta}</a>
        <a href="#terms" class="btn btn-ghost btn-lg">{a.terms.box.price} · {a.terms.title}</a>
      </div>
    </div>
  </div>
</section>

<!-- Who + contents -->
<section class="section-sm bg-dots">
  <div class="wrap au-two">
    <div class="callout" data-reveal>
      <div class="callout-title">{a.hero.who.title}</div>
      <p>{a.hero.who.text}</p>
    </div>
    <div data-reveal style="--d:80ms">
      <div class="eyebrow">{a.hero.contents.title}</div>
      <ol class="toc mono">
        {a.hero.contents.items.map((it, i) => (
          <li><a href={['#scope', '#process', '#checklist', '#terms'][i]}>{it}</a></li>
        ))}
      </ol>
    </div>
  </div>
</section>

<!-- 01 Scope -->
<section class="section" id="scope">
  <div class="wrap">
    <div class="num-head" data-reveal>
      <span class="mono num">{a.scope.num}</span>
      <div>
        <h2 class="h2">{a.scope.title}</h2>
        <p class="lead text-muted">{a.scope.sub}</p>
      </div>
    </div>
    <div class="eyebrow" data-reveal>{a.scope.inTitle}</div>
    <div class="table-wrap" data-reveal>
      <table class="table scope">
        <thead><tr>{a.scope.cols.map((c) => <th>{c}</th>)}</tr></thead>
        <tbody>{a.scope.rows.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
      </table>
    </div>
    <div class="eyebrow mt-lg" data-reveal>{a.scope.outTitle}</div>
    <ul class="bullets out" data-reveal>
      {a.scope.out.map((o) => <li><b>{o.b}</b> {o.t}</li>)}
    </ul>
    <div class="callout mt-lg" data-reveal>
      <div class="callout-title">{a.scope.more.title}</div>
      <p>{a.scope.more.text}</p>
    </div>
  </div>
</section>

<!-- 02 Process -->
<section class="section bg-dots" id="process">
  <div class="wrap">
    <div class="num-head" data-reveal>
      <span class="mono num">{a.process.num}</span>
      <div>
        <h2 class="h2">{a.process.title}</h2>
        <p class="lead text-muted">{a.process.sub}</p>
      </div>
    </div>
    <ol class="steps5">
      {a.process.steps.map((st, i) => (
        <li class="step5" data-reveal style={`--d:${i * 60}ms`}>
          <span class="mono step5-k">{st.step}</span>
          <h3 class="h3 green">{st.title}</h3>
          <p class="small text-muted">{st.text}</p>
        </li>
      ))}
    </ol>
    <div class="au-two mt-lg">
      <div data-reveal>
        <div class="eyebrow">{a.process.timelineTitle}</div>
        <table class="table mt">
          <thead><tr>{a.process.timelineCols.map((c) => <th>{c}</th>)}</tr></thead>
          <tbody>{a.process.timeline.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
        </table>
        <p class="small text-muted mt">{a.process.timelineNote}</p>
      </div>
      <div data-reveal style="--d:80ms">
        <div class="eyebrow">{a.process.receiveTitle}</div>
        <ul class="bullets mt">
          {a.process.receive.map((r) => <li><b>{r.b}</b> {r.t}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- 03 Checklist -->
<section class="section" id="checklist">
  <div class="wrap">
    <div class="num-head" data-reveal>
      <span class="mono num">{a.checklist.num}</span>
      <div>
        <h2 class="h2">{a.checklist.title}</h2>
        <p class="lead text-muted">{a.checklist.sub}</p>
      </div>
    </div>
    <ul class="checks" data-reveal>
      {a.checklist.items.map((it) => <li><b>{it.b}</b> {it.t}</li>)}
    </ul>
    <div class="au-two mt-lg">
      <div data-reveal>
        <div class="eyebrow">{a.checklist.helpfulTitle}</div>
        <ul class="bullets mt">{a.checklist.helpful.map((h) => <li>{h}</li>)}</ul>
      </div>
      <div class="callout" data-reveal style="--d:80ms">
        <div class="callout-title">{a.checklist.access.title}</div>
        <p>{a.checklist.access.text}</p>
      </div>
    </div>
  </div>
</section>

<!-- 04 Terms -->
<section class="section bg-dots" id="terms">
  <div class="wrap">
    <div class="num-head" data-reveal>
      <span class="mono num">{a.terms.num}</span>
      <div>
        <h2 class="h2">{a.terms.title}</h2>
        <p class="lead text-muted">{a.terms.sub}</p>
      </div>
    </div>
    <div class="price-box" data-reveal>
      <div>
        <div class="eyebrow">{a.terms.box.eyebrow}</div>
        <p>{a.terms.box.text}</p>
      </div>
      <div class="price-box-amount">{a.terms.box.price}</div>
    </div>
    <table class="table mt-lg" data-reveal>
      <thead><tr>{a.terms.cols.map((c) => <th>{c}</th>)}</tr></thead>
      <tbody>{a.terms.rows.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
    </table>
    <div class="eyebrow mt-lg" data-reveal>{a.terms.afterTitle}</div>
    <div class="grid-3 mt">
      {a.terms.after.map((it, i) => (
        <div class="after" data-reveal style={`--d:${i * 60}ms`}>
          <span class="mono after-tag">{it.tag}</span>
          <h3 class="h3 green">{it.href ? <a href={p(it.href)}>{it.title} →</a> : it.title}</h3>
          <p class="small text-muted">{it.text}</p>
        </div>
      ))}
    </div>
    <p class="small text-muted mt" data-reveal>{a.terms.afterNote}</p>
    <div class="next card-dark bg-lines mt-lg" data-reveal>
      <div>
        <div class="eyebrow">{a.terms.next.eyebrow}</div>
        <p>{a.terms.next.text}</p>
      </div>
      <a href={SITE.booking} class="btn btn-light btn-lg" target="_blank" rel="noopener" data-track="cta_book_click" data-location="audit-terms">{a.terms.next.cta}</a>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section">
  <div class="wrap faq-wrap">
    <div>
      <div class="eyebrow" data-reveal>{a.faq.eyebrow}</div>
      <h2 class="h2" data-reveal style="--d:60ms">{a.faq.h2}</h2>
    </div>
    <div data-reveal style="--d:120ms"><Faq items={a.faq.items} /></div>
  </div>
</section>

<CtaBand lang={lang} title={d.home.finalCta.h2} text={d.home.finalCta.text} primary={{ label: a.hero.cta }} location="audit-final" />

<script is:inline>window.fcTrack && window.fcTrack('audit_view', { page_path: location.pathname });</script>

<style>
  .au-hero { padding: clamp(56px, 8vw, 96px) 0 clamp(48px, 6vw, 80px); }
  .au-hero-in { max-width: 900px; display: grid; gap: 16px; }
  .au-sub { font-family: var(--font-head); font-weight: 500; font-size: clamp(20px, 2.2vw, 26px); line-height: 1.3; color: var(--color-accent-2); margin: 0; }
  .au-text { margin: 0; font-size: 17px; line-height: 1.65; max-width: 760px; }
  .au-facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 18px; }
  @media (min-width: 768px) { .au-facts { grid-template-columns: repeat(4, 1fr); } }
  .au-fact-num { font-size: clamp(30px, 3.6vw, 44px); }
  .au-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  .au-two { display: grid; gap: 24px; align-items: start; }
  @media (min-width: 900px) { .au-two { grid-template-columns: 1fr 1fr; gap: 40px; } }
  .toc { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 8px; font-size: 14px; counter-reset: t; }
  .toc li { counter-increment: t; display: flex; gap: 12px; border-bottom: 1px solid var(--color-line); padding-bottom: 8px; }
  .toc li::before { content: '0' counter(t); color: var(--color-green); }
  .toc a:hover { color: var(--color-green); }
  .num-head { display: flex; gap: 18px; align-items: flex-start; margin-bottom: clamp(24px, 4vw, 36px); max-width: 860px; }
  .num-head .num { font-size: 13px; color: var(--color-green); margin-top: 10px; }
  .num-head h2 { margin: 0 0 10px; }
  .num-head .lead { margin: 0; }
  .scope td:first-child { min-width: 160px; }
  .scope td:not(:first-child) { min-width: 220px; }
  .out b { color: var(--color-ink); }
  .checks b { color: var(--color-ink); }
  .mt { margin-top: 12px; }
  .mt-lg { margin-top: 32px; }
  .steps5 { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
  @media (min-width: 900px) { .steps5 { grid-template-columns: repeat(5, 1fr); } }
  .step5 { border-top: 2px solid var(--color-green); padding-top: 12px; display: grid; gap: 6px; align-content: start; }
  .step5-k { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--color-gray); }
  .step5 h3 { margin: 0; }
  .step5 p { margin: 0; }
  .price-box { background: var(--color-green); color: #fff; padding: 24px 28px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; border-radius: var(--radius-xs); }
  .price-box .eyebrow { color: #cfe3d8; }
  .price-box p { margin: 6px 0 0; max-width: 520px; color: #e6eae7; }
  .price-box-amount { font-family: var(--font-head); font-weight: 700; font-size: clamp(36px, 5vw, 56px); letter-spacing: -0.02em; line-height: 1; }
  .grid-3 { display: grid; gap: 16px; }
  @media (min-width: 768px) { .grid-3 { grid-template-columns: repeat(3, 1fr); } }
  .after { border-top: 2px solid var(--color-green); padding-top: 12px; display: grid; gap: 6px; align-content: start; }
  .after-tag { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--color-gray); }
  .after h3 { margin: 0; }
  .after p { margin: 0; }
  .next { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 18px; }
  .next p { margin: 6px 0 0; color: #e6eae7; }
  .faq-wrap { display: grid; gap: 24px; }
  @media (min-width: 900px) { .faq-wrap { grid-template-columns: .8fr 1.2fr; gap: 48px; } }
</style>
