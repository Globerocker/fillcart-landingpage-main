---
import Header from './Header.astro';
import Footer from './Footer.astro';
import Hero from './sections/Hero.astro';
import Problem from './sections/Problem.astro';
import Deal from './sections/Deal.astro';
import Timeline from './sections/Timeline.astro';
import RoiCalculator from './sections/RoiCalculator.astro';
import Usp from './sections/Usp.astro';
import Services from './sections/Services.astro';
import Proof from './sections/Proof.astro';
import Faq from './sections/Faq.astro';
import FinalCta from './sections/FinalCta.astro';
import type { LandingContent } from '../i18n/types.ts';

interface Props { content: LandingContent; }
const { content } = Astro.props;
---

<Header content={content} />
<main>
  <Hero content={content} />
  <Problem content={content} />
  <Deal content={content} />
  <Timeline content={content} />
  <RoiCalculator content={content} />
  <Usp content={content} />
  <Services content={content} />
  <Proof content={content} />
  <Faq content={content} />
  <FinalCta content={content} />
</main>
<Footer content={content} />
