---
import type { Locale } from '../config/site.ts';
import { getDict } from '../lib/i18n.ts';
import { slugOf, type WorkEntry } from '../lib/content.ts';
interface Props { entry: WorkEntry; lang: Locale; style?: string }
const { entry, lang, style } = Astro.props;
const d = getDict(lang);
const { data } = entry;
const href = `/work/${slugOf(entry.id)}`;
const metric = data.heroMetric ?? data.metrics[0];
---

<a href={href} class="cc card card-hover" data-reveal style={style}>
  <div class="cc-top">
    <div class="cc-tags">
      {data.services.slice(0, 3).map((s) => <span class="tag">{s}</span>)}
    </div>
    {!data.approved && <span class="tag tag-warn">{d.common.todo}</span>}
  </div>
  {metric && (
    <div class="cc-metric">
      <div class="cc-val">{metric.value}</div>
      <div class="cc-lab">{metric.label}</div>
    </div>
  )}
  <h3 class="cc-title">{data.title}</h3>
  <p class="cc-sum">{data.summary}</p>
  <div class="cc-client mono">{data.client}</div>
</a>

<style>
  .cc { display: grid; gap: 14px; align-content: start; color: var(--color-ink); }
  .cc-top { display: flex; justify-content: space-between; gap: 8px; align-items: flex-start; }
  .cc-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .cc-metric { border-top: 2px solid var(--color-green); padding-top: 12px; }
  .cc-val { font-family: var(--font-head); font-weight: 700; font-size: clamp(32px, 3.6vw, 44px); line-height: 1; letter-spacing: -0.02em; color: var(--color-green); font-variant-numeric: tabular-nums; }
  .cc-lab { font-size: 13.5px; color: var(--color-gray); margin-top: 6px; line-height: 1.4; }
  .cc-title { font-size: 20px; line-height: 1.25; margin: 0; }
  .cc-sum { margin: 0; font-size: 15px; line-height: 1.55; color: var(--color-gray); }
  .cc-client { font-size: 12px; color: var(--color-gray); letter-spacing: .03em; margin-top: auto; }
</style>
