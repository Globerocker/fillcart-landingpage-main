---
import { SITE } from '../config/site.ts';
import type { Lang } from '../i18n/types.ts';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const ct = SITE.contact;
const text = encodeURIComponent(lang === 'en' ? ct.whatsappTextEn : ct.whatsappText);
const href = `${ct.whatsappHref}?text=${text}`;
const label = lang === 'en' ? 'Chat on WhatsApp' : 'Per WhatsApp schreiben';
const tip = lang === 'en' ? 'Questions? Write us' : 'Fragen? Schreib uns';
---

<a class="wa-float" href={href} target="_blank" rel="noopener" aria-label={label}>
  <span class="wa-tip">{tip}</span>
  <span class="wa-icon">
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.9c0 1.76.46 3.45 1.34 4.95L2 22l5.3-1.39c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.9C21.95 6.45 17.5 2 12.04 2m0 18.15c-1.48 0-2.93-.4-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.39c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.16 8.16 0 0 1 2.41 5.82c0 4.54-3.69 8.23-8.23 8.23m4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.42-.14-.01-.31-.01-.48-.01a.92.92 0 0 0-.67.31c-.23.25-.88.86-.88 2.09s.9 2.43 1.03 2.6c.13.16 1.78 2.72 4.3 3.81.6.26 1.07.41 1.44.53.6.19 1.15.16 1.59.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29"/></svg>
  </span>
</a>

<style>
  .wa-float {
    position: fixed; right: 22px; bottom: 22px; z-index: 60;
    display: flex; align-items: center; gap: 10px;
  }
  .wa-icon {
    width: 58px; height: 58px; border-radius: 50%;
    background: #25d366; color: #fff;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 14px 34px -8px rgba(37, 211, 102, 0.65);
    transition: transform 0.25s var(--ease-spring), box-shadow 0.25s;
  }
  .wa-float:hover .wa-icon { transform: scale(1.08) translateY(-2px); box-shadow: 0 20px 40px -8px rgba(37, 211, 102, 0.75); }
  .wa-icon::after {
    content: ''; position: absolute; width: 58px; height: 58px; border-radius: 50%;
    background: #25d366; opacity: 0.5; animation: wa-ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite; z-index: -1;
  }
  .wa-tip {
    background: #fff; color: #0b1b33; font-size: 13.5px; font-weight: 600;
    padding: 9px 14px; border-radius: 999px; box-shadow: 0 10px 30px -10px rgba(11, 27, 51, 0.4);
    white-space: nowrap;
    opacity: 0; transform: translateX(8px); pointer-events: none;
    transition: opacity 0.25s, transform 0.25s;
  }
  .wa-float:hover .wa-tip { opacity: 1; transform: translateX(0); }

  @keyframes wa-ping { 0% { transform: scale(1); opacity: 0.5; } 80%, 100% { transform: scale(1.6); opacity: 0; } }

  @media (max-width: 600px) {
    .wa-float { right: 16px; bottom: 16px; }
    .wa-icon { width: 52px; height: 52px; }
    .wa-tip { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-icon::after { animation: none; display: none; }
  }
</style>
