---
import { SITE } from '../config/site.ts';
import type { LandingContent } from '../i18n/types.ts';

interface Props {
  content: LandingContent;
}
const { content } = Astro.props;
const f = content.footer;
const c = SITE.company;
---

<footer class="ft">
  <div class="ft-topline"></div>
  <div class="ft-inner">
    <div class="ft-grid">
      <div class="ft-brand">
        <img src="/assets/logo-white.png" alt="Fillcart" width="112" height="28" />
        <p>{f.tagline}</p>
        <div class="ft-badges">
          <span class="ft-badge-google"><img src="/assets/google-partner.png" alt="Google Partner" width="86" height="26" /></span>
          <span class="ft-badge-hs">{f.hubspotBadge}</span>
        </div>
      </div>

      <div class="ft-col">
        <div class="ft-col-title">{f.colCompanyTitle}</div>
        {f.colCompany.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>

      <div class="ft-col">
        <div class="ft-col-title">{f.colLegalTitle}</div>
        {f.colLegal.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>

      <div class="ft-col">
        <div class="ft-col-title">{f.colContactTitle}</div>
        <a href={`mailto:${c.email}`}>{c.email}</a>
        <span class="ft-address">
          {c.legalName}<br />
          {c.street}<br />
          {c.city}, {c.region} {c.postalCode}, {c.countryLabel}
        </span>
      </div>
    </div>

    <div class="ft-bottom">
      <span>{f.copyright}</span>
      <span>{f.registration}</span>
    </div>
  </div>
</footer>

<style>
  .ft {
    background: #06111f;
    padding: 64px 32px 40px;
    position: relative;
    overflow: hidden;
  }
  .ft-topline {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(249, 115, 22, 0.5), rgba(34, 197, 94, 0.4), transparent);
  }
  .ft-inner { max-width: 1120px; margin: 0 auto; }
  .ft-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 40px 32px;
  }
  .ft-brand { max-width: 380px; }
  .ft-brand img { height: 28px; width: auto; display: block; }
  .ft-brand p { color: #64748b; font-size: 14px; line-height: 1.7; margin: 18px 0 0; }
  .ft-badges { display: flex; gap: 12px; margin-top: 20px; align-items: center; flex-wrap: wrap; }
  .ft-badge-google {
    background: #fff;
    border-radius: 8px;
    padding: 6px 12px;
    display: inline-flex;
  }
  .ft-badge-google img { height: 26px; width: auto; }
  .ft-badge-hs {
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    padding: 8px 12px;
    color: #94a3b8;
    font-size: 13px;
    font-weight: 600;
  }

  .ft-col { display: flex; flex-direction: column; gap: 10px; }
  .ft-col-title {
    color: #f97316;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .ft-col a { color: #94a3b8; font-size: 15px; }
  .ft-col a:hover { color: #fff; }
  .ft-address { color: #64748b; font-size: 14px; line-height: 1.6; }

  .ft-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    margin-top: 44px;
    padding-top: 24px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
  }
  .ft-bottom span { color: #475569; font-size: 13px; }

  @media (max-width: 820px) {
    .ft-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
    .ft-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .ft-grid { grid-template-columns: 1fr; }
  }
</style>
