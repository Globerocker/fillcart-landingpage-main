---
import type { Locale } from '../config/site.ts';
import { getDict } from '../lib/i18n.ts';
import { slugOf, fmtDate, readingTime, type InsightEntry } from '../lib/content.ts';
interface Props { entry: InsightEntry; lang: Locale; style?: string }
const { entry, lang, style } = Astro.props;
const d = getDict(lang);
const { data } = entry;
const base = data.lang === 'en' ? '/insights' : '/de/insights';
const href = `${base}/${slugOf(entry.id)}`;
const rt = readingTime(entry.body, data.readingTime);
---

<a href={href} class="ac card card-hover" data-reveal style={style} hreflang={data.lang} lang={data.lang}>
  <div class="ac-meta">
    <span class="tag tag-green">{d.insights.topics[data.topic] ?? data.topic}</span>
    {data.lang !== lang && <span class="tag">{data.lang.toUpperCase()}</span>}
  </div>
  <h3 class="ac-title">{data.title}</h3>
  <p class="ac-desc">{data.description}</p>
  <div class="ac-foot mono">
    <time datetime={data.publishDate.toISOString()}>{fmtDate(data.publishDate, d.locale)}</time>
    <span>·</span>
    <span>{rt} {d.common.minRead}</span>
  </div>
</a>

<style>
  .ac { display: grid; gap: 12px; align-content: start; color: var(--color-ink); padding: 24px; }
  .ac-meta { display: flex; gap: 6px; flex-wrap: wrap; }
  .ac-title { font-size: 19px; line-height: 1.3; margin: 0; }
  .ac-desc { margin: 0; font-size: 15px; line-height: 1.55; color: var(--color-gray); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .ac-foot { display: flex; gap: 8px; font-size: 12px; color: var(--color-gray); margin-top: auto; }
</style>
