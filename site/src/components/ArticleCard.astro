---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES, fmtDate } from '../lib/blog.ts';

interface Props { entry: CollectionEntry<'blog'>; featured?: boolean; }
const { entry, featured = false } = Astro.props;
const { data } = entry;
const cat = CATEGORIES[data.category];
const slug = entry.id.replace(/^.*\//, '');
const href = `/wissen/${data.category}/${slug}/`;
---

<a href={href} class={`acard fc-lift ${featured ? 'acard-feat' : ''}`} style={`--accent:${cat.accent}`}>
  <div class="acard-top">
    <span class="acard-cat">{cat.label}</span>
    {data.heroStat && (
      <span class="acard-stat"><b>{data.heroStat.value}</b>{data.heroStat.label}</span>
    )}
  </div>
  <h3 class="acard-title">{data.title}</h3>
  <p class="acard-desc">{data.description}</p>
  <div class="acard-foot">
    <time datetime={data.publishDate.toISOString()}>{fmtDate(data.publishDate)}</time>
    <span class="acard-more">Lesen →</span>
  </div>
</a>

<style>
  .acard {
    display: flex; flex-direction: column; gap: 12px;
    background: #fff; border: 1px solid var(--border); border-radius: 18px;
    padding: 26px 24px; height: 100%;
    border-top: 3px solid var(--accent);
  }
  .acard:hover {
    transform: translateY(-5px);
    box-shadow: 0 28px 50px -24px rgba(11, 27, 51, 0.28);
    border-color: var(--accent);
    border-top-color: var(--accent);
    color: inherit;
  }
  .acard-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .acard-cat {
    font-size: 11.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent);
    padding: 4px 10px; border-radius: 999px;
  }
  .acard-stat { font-size: 12px; color: var(--slate-500); display: flex; align-items: baseline; gap: 5px; }
  .acard-stat b { font-family: var(--font-head); font-size: 15px; color: var(--navy); }
  .acard-title {
    font-family: var(--font-head); font-weight: 600; font-size: 20px; line-height: 1.25;
    color: var(--navy); margin: 0;
  }
  .acard-feat .acard-title { font-size: 26px; }
  .acard-desc { color: var(--slate-600); font-size: 14.5px; line-height: 1.55; margin: 0; flex: 1; }
  .acard-foot {
    display: flex; align-items: center; justify-content: space-between;
    margin-top: 4px; padding-top: 14px; border-top: 1px solid var(--border);
    font-size: 13px; color: var(--slate-500);
  }
  .acard-more { color: var(--accent); font-weight: 600; }
</style>
