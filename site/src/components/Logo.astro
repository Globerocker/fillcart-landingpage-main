---
/** The F monogram (concept A). `tile` renders the green square; `mono` uses currentColor; `animate` plays the fill-level animation. */
interface Props {
  size?: number;
  tile?: boolean;
  mono?: boolean;
  animate?: boolean;
  class?: string;
  title?: string;
}
const { size = 36, tile = true, mono = false, animate = false, class: cls = '', title } = Astro.props;
const bars = mono || !tile ? 'currentColor' : '#ffffff';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  class:list={['f-logo', cls, { 'f-animate': animate }]}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  {tile && !mono && <rect width="64" height="64" rx="12" fill="#1e5b3c" />}
  {tile && mono && <rect width="64" height="64" rx="12" fill="currentColor" opacity=".12" />}
  <g fill={bars}>
    <rect x="12" y="8" width="40" height="7.5" rx="1.5" />
    <rect x="12" y="18" width="14" height="7.5" rx="1.5" />
    <rect x="12" y="28" width="30" height="7.5" rx="1.5" />
    <rect x="12" y="38" width="14" height="7.5" rx="1.5" />
    <rect x="12" y="48" width="14" height="7.5" rx="1.5" />
  </g>
</svg>
