---
import type { LandingContent } from '../../i18n/types.ts';
interface Props { content: LandingContent; }
const { content } = Astro.props;
const d = content.deal;
---

<section id="deal" class="section deal">
  <div class="deal-glow"></div>
  <div class="deal-mesh"></div>
  <div class="deal-inner">
    <div class="deal-head" data-reveal>
      <div class="eyebrow">{d.eyebrow}</div>
      <h2 class="h2 on-dark">{d.headline}</h2>
      <p class="deal-intro">{d.intro}</p>
    </div>

    <div class="deal-steps">
      {d.steps.map((s) => (
        <div class="deal-step fc-lift" data-reveal>
          <div class="deal-step-top">
            <div class="deal-step-num">{s.num}</div>
            <span class={`deal-badge ${s.badgeColor}`}>{s.badge}</span>
          </div>
          <h3 class="deal-step-title">{s.title}</h3>
          <ul class="deal-list">
            {s.items.map((it) => (
              <li><span class="chev">›</span><span set:html={it} /></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="deal-callouts">
      <div class="callout callout-test" data-reveal>
        <div class="callout-big-wrap">
          <div class="callout-big orange">{d.callouts.test.big}</div>
          <div class="callout-unit orange">{d.callouts.test.unit}</div>
        </div>
        <div>
          <h4 class="callout-title">{d.callouts.test.title}</h4>
          <p class="callout-text" set:html={d.callouts.test.text} />
        </div>
      </div>
      <div class="callout callout-retainer" data-reveal>
        <div class="callout-big-wrap">
          <div class="callout-big green">{d.callouts.retainer.big}</div>
          <div class="callout-unit green">{d.callouts.retainer.unit}</div>
        </div>
        <div>
          <h4 class="callout-title">{d.callouts.retainer.title}</h4>
          <p class="callout-text" set:html={d.callouts.retainer.text} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .deal { background: #0b1b33; padding: 100px 32px; }
  .deal-glow {
    position: absolute; bottom: -140px; left: -100px; width: 520px; height: 520px;
    background: radial-gradient(circle, rgba(249, 115, 22, 0.14), transparent 65%);
    pointer-events: none;
  }
  .deal-mesh {
    position: absolute; inset: 0; pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 54px 54px;
    -webkit-mask-image: radial-gradient(circle at 70% 30%, #000, transparent 75%);
    mask-image: radial-gradient(circle at 70% 30%, #000, transparent 75%);
  }
  .deal-inner { max-width: 1120px; margin: 0 auto; position: relative; }
  .deal-head { max-width: 720px; }
  .h2.on-dark { color: #fff; }
  .deal-intro { color: #94a3b8; font-size: 18px; line-height: 1.6; margin: 18px 0 0; }

  .deal-steps {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 44px;
  }
  .deal-step {
    background: #12233f; border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px; padding: 30px 26px;
  }
  .deal-step:hover { transform: translateY(-6px); border-color: rgba(249, 115, 22, 0.5); }
  .deal-step-top { display: flex; align-items: center; justify-content: space-between; }
  .deal-step-num {
    font-family: var(--font-head); font-weight: 700; font-size: 40px; color: #f97316; line-height: 1;
  }
  .deal-badge { font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 999px; }
  .deal-badge.green { color: #22c55e; background: rgba(34, 197, 94, 0.14); }
  .deal-badge.sky { color: #38bdf8; background: rgba(56, 189, 248, 0.14); }
  .deal-step-title {
    font-family: var(--font-head); font-weight: 600; font-size: 20px;
    color: #fff; margin: 16px 0 12px;
  }
  .deal-list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 9px; }
  .deal-list li {
    color: #94a3b8; font-size: 14.5px; line-height: 1.4;
    padding-left: 20px; position: relative;
  }
  .deal-list .chev { position: absolute; left: 0; top: 1px; color: #f97316; }

  .deal-callouts {
    display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-top: 24px;
  }
  .callout {
    border-radius: 18px; padding: 26px 28px;
    display: flex; align-items: center; gap: 22px;
  }
  .callout-test {
    background: linear-gradient(135deg, rgba(249, 115, 22, 0.14), rgba(249, 115, 22, 0.04));
    border: 1px solid rgba(249, 115, 22, 0.4);
  }
  .callout-retainer {
    background: #12233f; border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .callout-big-wrap { flex-shrink: 0; }
  .callout-big { font-family: var(--font-head); font-weight: 700; font-size: 52px; line-height: 0.9; }
  .callout-big.orange { color: #f97316; }
  .callout-big.green { color: #22c55e; }
  .callout-unit { font-size: 13px; font-weight: 600; text-align: center; letter-spacing: 0.02em; }
  .callout-unit.orange { color: #fdba74; }
  .callout-unit.green { color: #86efac; }
  .callout-title { font-family: var(--font-head); font-weight: 600; font-size: 17px; color: #fff; margin: 0; }
  .callout-text { color: #94a3b8; font-size: 14.5px; line-height: 1.5; margin: 8px 0 0; }
  .callout-text :global(b) { color: #e2e8f0; }

  @media (max-width: 900px) {
    .deal-steps { grid-template-columns: 1fr; }
    .deal-callouts { grid-template-columns: 1fr; }
  }
</style>
