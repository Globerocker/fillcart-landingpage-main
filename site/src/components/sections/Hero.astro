---
import type { LandingContent } from '../../i18n/types.ts';

interface Props {
  content: LandingContent;
}
const { content } = Astro.props;
const h = content.hero;
const base = content.homePath.replace(/\/$/, '');
const stageData = {
  deals: content.hero_deals,
  total: content.pipelineTotal,
  label: h.cartLabel,
  locale: content.lang === 'en' ? 'en-US' : 'de-DE',
};
---

<section class="hero">
  <div class="hero-glow hero-glow-a"></div>
  <div class="hero-glow hero-glow-b"></div>
  <div class="hero-mesh"></div>

  <div class="hero-inner">
    <div class="hero-copy">
      <div class="hero-badge">
        <span class="dot"></span>
        <span set:html={h.badge} />
      </div>
      <h1 class="hero-h1" set:html={h.headline} />
      <p class="hero-sub" set:html={h.sub} />
      <div class="hero-bullets">
        {h.bullets.map((b) => (
          <div class="hero-bullet">
            <span class="check">✓</span>
            <span set:html={b} />
          </div>
        ))}
      </div>
      <div class="hero-ctas">
        <a href={`${base}/#audit`} class="btn-primary fc-lift">{h.ctaPrimary}</a>
        <a href={`${base}/#rechner`} class="btn-ghost fc-lift">{h.ctaSecondary}</a>
      </div>
    </div>

    <div class="hero-stage-col">
      <div
        class="cart-stage"
        id="cart-stage"
        data-stage={JSON.stringify(stageData)}
        aria-hidden="true"
      >
        <!-- Static fallback (no-JS / pre-hydration): START state, so JS hydration
             continues seamlessly from here instead of flashing a full cart. -->
        <div class="cart-stage-fallback">
          <div class="fb-counter">
            <div class="fb-label">{h.cartLabel}</div>
            <div class="fb-value">€ 0</div>
            <div class="fb-bar"><span style="width:0"></span></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Trust bar -->
  <div class="trust">
    <div class="trust-inner">
      <span class="trust-label">{content.trust.label}</span>
      {content.trust.items.map((item, i) => (
        <>
          {i > 0 && <span class="trust-sep">|</span>}
          <span class="trust-item">{item}</span>
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .hero { background: #0b1b33; position: relative; overflow: hidden; }
  .hero-glow { position: absolute; pointer-events: none; }
  .hero-glow-a {
    top: -180px; right: -140px; width: 680px; height: 680px;
    background: radial-gradient(circle, rgba(249, 115, 22, 0.22), transparent 62%);
  }
  .hero-glow-b {
    bottom: -160px; left: -120px; width: 520px; height: 520px;
    background: radial-gradient(circle, rgba(34, 197, 94, 0.12), transparent 65%);
  }
  .hero-mesh {
    position: absolute; inset: 0; pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 54px 54px;
    -webkit-mask-image: radial-gradient(circle at 35% 45%, #000, transparent 78%);
    mask-image: radial-gradient(circle at 35% 45%, #000, transparent 78%);
  }
  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 76px 32px 40px;
    display: grid;
    grid-template-columns: 1.04fr 0.96fr;
    gap: 48px;
    align-items: center;
    position: relative;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(249, 115, 22, 0.12);
    border: 1px solid rgba(249, 115, 22, 0.35);
    color: #fdba74;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 7px 14px;
    border-radius: 999px;
  }
  .hero-badge .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: #f97316; display: inline-block;
    animation: fc-pulse 2s infinite;
  }

  .hero-h1 {
    font-family: var(--font-head);
    font-weight: 700;
    color: #fff;
    font-size: 56px;
    line-height: 1.04;
    letter-spacing: -0.025em;
    margin: 22px 0 0;
  }
  .hero-h1 :global(.muted) { color: #94a3b8; }
  .hero-h1 :global(.accent) { color: #f97316; }

  .hero-sub {
    color: #94a3b8;
    font-size: 18px;
    line-height: 1.6;
    max-width: 500px;
    margin: 22px 0 0;
  }
  .hero-sub :global(.hl) { color: #e2e8f0; font-weight: 500; }

  .hero-bullets {
    display: flex; flex-direction: column; gap: 11px;
    margin: 26px 0 0; max-width: 460px;
  }
  .hero-bullet {
    display: flex; align-items: center; gap: 11px;
    color: #cbd5e1; font-size: 15.5px;
  }
  .hero-bullet :global(b) { color: #fff; }
  .hero-bullet .check {
    flex-shrink: 0; width: 22px; height: 22px; border-radius: 6px;
    background: rgba(34, 197, 94, 0.16); color: #22c55e;
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 700;
  }

  .hero-ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }
  .btn-primary {
    background: #f97316; color: #fff; font-size: 16px; font-weight: 600;
    padding: 16px 26px; border-radius: 12px;
    box-shadow: 0 14px 30px -8px rgba(249, 115, 22, 0.6);
  }
  .btn-primary:hover {
    color: #fff; transform: translateY(-2px);
    box-shadow: 0 20px 38px -8px rgba(249, 115, 22, 0.7);
  }
  .btn-ghost {
    color: #e2e8f0; font-size: 16px; font-weight: 600;
    padding: 16px 22px; border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.16);
  }
  .btn-ghost:hover { color: #fff; border-color: rgba(255, 255, 255, 0.4); transform: translateY(-2px); }

  /* ---- Cart stage ---- */
  .hero-stage-col { display: flex; justify-content: center; }
  .cart-stage {
    position: relative;
    width: 100%;
    max-width: 470px;
    height: 476px;
    margin: 0 auto;
  }
  .cart-stage::before {
    content: '';
    position: absolute; left: 50%; bottom: 30px;
    width: 360px; height: 360px; transform: translateX(-50%);
    background: radial-gradient(circle, rgba(249, 115, 22, 0.2), transparent 62%);
    pointer-events: none;
  }
  .cart-stage-fallback {
    position: absolute; inset: 0;
    display: flex; align-items: flex-start; justify-content: center;
    padding-top: 46px; /* match the live counter's top offset → no jump on hydration */
  }
  .fb-counter { text-align: center; width: 100%; }
  .fb-label {
    font-size: 12px; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: #64748b;
  }
  .fb-value {
    font-family: var(--font-head); font-size: 46px; font-weight: 700;
    color: #f97316; letter-spacing: -0.02em; line-height: 1.1; margin-top: 4px;
  }
  .fb-bar {
    width: 220px; height: 6px; border-radius: 999px;
    background: rgba(255, 255, 255, 0.1); margin: 12px auto 0; overflow: hidden;
  }
  .fb-bar span {
    display: block; width: 100%; height: 100%; border-radius: 999px;
    background: linear-gradient(90deg, #f97316, #22c55e);
  }

  /* ---- Trust bar ---- */
  .trust { border-top: 1px solid rgba(255, 255, 255, 0.08); position: relative; }
  .trust-inner {
    max-width: 1200px; margin: 0 auto; padding: 20px 32px;
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 12px 34px; justify-content: center;
  }
  .trust-label {
    color: #f97316; font-size: 12px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
  }
  .trust-item { color: #cbd5e1; font-size: 15px; font-weight: 600; }
  .trust-sep { color: #334155; }

  @media (max-width: 960px) {
    .hero-inner { grid-template-columns: 1fr; gap: 20px; padding: 48px 22px 32px; }
    .hero-h1 { font-size: 40px; }
    .hero-stage-col { order: -1; }
    .cart-stage { height: 420px; }
    .trust-inner { padding: 20px 22px; }
  }
  @media (max-width: 480px) {
    .hero-h1 { font-size: 33px; }
    .hero-sub { font-size: 16px; }
  }
</style>

<script>
  const stage = document.getElementById('cart-stage');
  if (stage) {
    const data = JSON.parse(stage.dataset.stage || '{}');
    const deals = data.deals || [];
    const total = data.total || 1;
    const label = data.label || '';
    const locale = data.locale || 'de-DE';
    const nf = new Intl.NumberFormat(locale);
    const dec = locale === 'de-DE' ? ',' : '.';
    const eur = (v) => '€ ' + nf.format(Math.round(v));
    const kchip = (v) => '+€' + (v >= 1000 ? (Math.round(v / 100) / 10).toString().replace('.', dec) + 'k' : v);
    const reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const CARDW = 190, SLOTX = 154, LANDTOP = 286;
    const el = (cls, html) => { const d = document.createElement('div'); d.className = cls; if (html != null) d.innerHTML = html; return d; };

    stage.innerHTML = '';

    const amb = el('cs-ambient');
    for (let i = 0; i < 14; i++) {
      const p = document.createElement('span');
      p.style.cssText = `left:${Math.round(8 + Math.random() * 84)}%;top:${Math.round(12 + Math.random() * 78)}%;animation-delay:${(Math.random() * 4).toFixed(2)}s;animation-duration:${(3 + Math.random() * 3).toFixed(2)}s`;
      amb.appendChild(p);
    }

    const source = el('cs-source', '<span class="cs-src-dot"></span>Neue Deals · live');
    const counter = el('cs-counter', `<div class="cs-clabel">${label}</div><div class="cs-cvalue">${eur(0)}</div><div class="cs-cbar"><span></span></div>`);
    const valueEl = counter.querySelector('.cs-cvalue');
    const barEl = counter.querySelector('.cs-cbar span');

    const cart = el('cs-cart');
    cart.innerHTML = `
      <svg viewBox="0 0 320 260" width="320" height="260" style="overflow:visible">
        <defs>
          <linearGradient id="cartFillG" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0" stop-color="#F97316" stop-opacity="0.55"/>
            <stop offset="1" stop-color="#22C55E" stop-opacity="0.30"/>
          </linearGradient>
          <clipPath id="cartClip"><path d="M88 78 L112 196 H232 L256 78 Z"/></clipPath>
        </defs>
        <g clip-path="url(#cartClip)"><rect class="cart-fill" x="80" y="196" width="184" height="0" fill="url(#cartFillG)"/></g>
        <g fill="none" stroke="#E2E8F0" stroke-width="10" stroke-linecap="round" stroke-linejoin="round">
          <path d="M40 44 H70 L96 60"/>
          <path d="M86 76 H262"/>
          <path d="M86 76 L110 196 H234 L262 76"/>
        </g>
        <circle cx="124" cy="224" r="12" fill="#E2E8F0"/>
        <circle cx="216" cy="224" r="12" fill="#E2E8F0"/>
      </svg>`;
    const fillEl = cart.querySelector('.cart-fill');

    const cardsLayer = el('cs-cards');
    const floats = el('cs-floats');
    stage.append(amb, source, counter, cart, cardsLayer, floats);

    const makeCard = (d) => el('cs-card', `
      <div class="cs-card-inner">
        <span class="cs-card-bar"></span>
        <span class="cs-card-body">
          <span class="cs-card-tag">${d.tag}</span>
          <span class="cs-card-val">+ €${nf.format(d.value)}</span>
        </span>
        <span class="cs-card-dot" style="background:${d.dot};box-shadow:0 0 0 4px ${d.dot}22"></span>
      </div>`);

    // Persistent landed-card nodes so a restack animates via CSS transition
    // instead of teleporting. Keep the last few visible; retire older ones with
    // a fade-out rather than letting them pop out of existence.
    const MAX_LANDED = 3;
    let landedCards = []; // { d, el }

    const restack = () => {
      const n = landedCards.length;
      landedCards.forEach(({ el }, p) => {
        const depth = n - 1 - p;
        el.style.left = SLOTX + 'px';
        el.style.top = (LANDTOP - depth * 20) + 'px';
        el.style.transform = `rotate(${(p % 2 ? 1 : -1) * 2.2}deg) scale(${1 - depth * 0.05})`;
        el.style.opacity = String(1 - depth * 0.18);
        el.style.zIndex = String(10 + p);
        el.style.setProperty('--fd', (p * 0.2) + 's');
      });
    };

    const addLanded = (d) => {
      const el = makeCard(d); el.classList.add('landed');
      // Appear exactly where the flying card settled → no pop-in.
      el.style.left = SLOTX + 'px';
      el.style.top = LANDTOP + 'px';
      el.style.zIndex = '30';
      cardsLayer.appendChild(el);
      landedCards.push({ d, el });
      while (landedCards.length > MAX_LANDED) {
        const gone = landedCards.shift();
        gone.el.classList.add('leaving');
        setTimeout(() => gone.el.remove(), 500);
      }
      // Next frame so the transition has a start value to animate from.
      requestAnimationFrame(restack);
    };

    const burst = (x, y) => {
      if (reduced) return;
      const b = el('cs-burst'); b.style.left = x + 'px'; b.style.top = y + 'px';
      for (let i = 0; i < 9; i++) {
        const s = document.createElement('i');
        s.style.background = i % 2 ? '#22C55E' : '#F97316';
        s.style.setProperty('--a', (i * 40) + 'deg');
        b.appendChild(s);
      }
      floats.appendChild(b); setTimeout(() => b.remove(), 660);
    };

    const floatChip = (v) => {
      if (reduced) return;
      const c = el('cs-floatchip', kchip(v));
      c.style.left = '50%'; c.style.top = (LANDTOP - 6) + 'px';
      floats.appendChild(c); setTimeout(() => c.remove(), 1250);
    };

    let pipe = 0, raf = 0;
    const setFill = (pct) => { const h = pct / 100 * 118; fillEl.setAttribute('y', String(196 - h)); fillEl.setAttribute('height', String(h)); };
    const tween = (from, to, dur) => {
      cancelAnimationFrame(raf); const t0 = performance.now();
      const step = (t) => {
        const p = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - p, 3);
        pipe = Math.round(from + (to - from) * e);
        valueEl.textContent = eur(pipe);
        const pct = Math.min(100, (pipe / total) * 100);
        barEl.style.width = pct + '%'; setFill(pct);
        if (p < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };

    const springCart = () => {
      if (reduced) return;
      cart.style.animation = 'none'; void cart.offsetWidth; cart.style.animation = 'cs-spring .5s cubic-bezier(.3,1.4,.5,1)';
    };

    const flyCard = (d, cb) => {
      const card = makeCard(d); card.classList.add('flying');
      card.style.left = '0px'; card.style.top = '0px'; card.style.zIndex = '30';
      cardsLayer.appendChild(card);
      const from = { x: SLOTX, y: 18 }, ctrl = { x: SLOTX + 70, y: 150 }, to = { x: SLOTX, y: LANDTOP };
      const dur = 820, t0 = performance.now(), startRot = -16 + Math.random() * 8;
      const step = (t) => {
        const p = Math.min(1, (t - t0) / dur), mt = 1 - p;
        const x = mt * mt * from.x + 2 * mt * p * ctrl.x + p * p * to.x;
        const y = mt * mt * from.y + 2 * mt * p * ctrl.y + p * p * to.y;
        const rot = startRot * (1 - (p < 0.85 ? p / 0.85 : 1));
        const sc = 0.72 + 0.28 * Math.min(1, p / 0.7);
        card.style.transform = `translate(${x}px,${y}px) rotate(${rot}deg) scale(${sc})`;
        card.style.opacity = String(Math.min(1, p * 5));
        if (p < 1) requestAnimationFrame(step); else { card.remove(); cb(); }
      };
      requestAnimationFrame(step);
    };

    const timers = []; let cum = 0;
    const clearTimers = () => { timers.forEach(clearTimeout); timers.length = 0; };

    const dropAt = (i) => {
      if (i >= deals.length) { timers.push(setTimeout(() => softReset(begin), 2200)); return; }
      const d = deals[i];
      flyCard(d, () => {
        const from = pipe; cum += d.value; tween(from, cum, 620);
        addLanded(d);
        springCart(); burst(SLOTX + 95, LANDTOP + 6); floatChip(d.value);
        timers.push(setTimeout(() => dropAt(i + 1), 820));
      });
    };

    // Graceful loop restart: ease the value back to zero and fade the cards out,
    // then refill — instead of snapping the full cart to empty in one frame.
    const softReset = (cb) => {
      clearTimers();
      const retiring = landedCards; landedCards = [];
      retiring.forEach(({ el }) => el.classList.add('leaving'));
      tween(pipe, 0, 520);
      timers.push(setTimeout(() => {
        retiring.forEach(({ el }) => el.remove());
        floats.innerHTML = ''; cum = 0; cb();
      }, 560));
    };

    function begin() {
      clearTimers();
      cum = 0; pipe = 0;
      valueEl.textContent = eur(0); barEl.style.width = '0%'; setFill(0);
      dropAt(0);
    }

    if (reduced) {
      cum = total; pipe = total;
      valueEl.textContent = eur(total); barEl.style.width = '100%'; setFill(100);
      deals.slice(-MAX_LANDED).forEach((d) => addLanded(d));
      requestAnimationFrame(restack);
    } else if ('IntersectionObserver' in window) {
      // Only run while the hero is on screen (saves CPU/battery when scrolled away).
      let running = false;
      new IntersectionObserver((entries) => {
        const vis = entries[0].isIntersecting;
        if (vis && !running) { running = true; begin(); }
        else if (!vis && running) { running = false; clearTimers(); cancelAnimationFrame(raf); }
      }, { threshold: 0.12 }).observe(stage);
    } else {
      begin();
    }
  }
</script>

<style is:global>
  .cs-ambient { position: absolute; inset: 0; pointer-events: none; z-index: 15; }
  .cs-ambient span { position: absolute; width: 4px; height: 4px; border-radius: 50%; background: rgba(148,163,184,.5); animation: cs-drift linear infinite; }
  @keyframes cs-drift { 0%{transform:translateY(0);opacity:0} 20%{opacity:.7} 80%{opacity:.4} 100%{transform:translateY(-28px);opacity:0} }

  .cs-source { position: absolute; top: 4px; left: 50%; transform: translateX(-50%); z-index: 36;
    display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 600; color: #CBD5E1;
    background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); padding: 6px 14px; border-radius: 999px; -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); }
  .cs-src-dot { width: 7px; height: 7px; border-radius: 50%; background: #22C55E; animation: cs-ping 1.8s infinite; }
  @keyframes cs-ping { 0%{box-shadow:0 0 0 0 rgba(34,197,94,.5)} 70%{box-shadow:0 0 0 8px rgba(34,197,94,0)} 100%{box-shadow:0 0 0 0 rgba(34,197,94,0)} }

  .cs-counter { position: absolute; top: 46px; left: 0; right: 0; text-align: center; z-index: 38; }
  .cs-clabel { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #64748B; }
  .cs-cvalue { font-family: var(--font-head); font-size: 46px; font-weight: 700; color: #F97316; letter-spacing: -.02em; line-height: 1.1; margin-top: 4px; text-shadow: 0 0 26px rgba(249,115,22,.35); }
  .cs-cbar { width: 230px; height: 7px; border-radius: 999px; background: rgba(255,255,255,.1); margin: 12px auto 0; overflow: hidden; }
  .cs-cbar span { display: block; width: 0; height: 100%; border-radius: 999px; background: linear-gradient(90deg,#F97316,#FDBA74,#22C55E); background-size: 200% 100%; animation: cs-shine 2.4s linear infinite; }
  @keyframes cs-shine { 0%{background-position:0 0} 100%{background-position:-200% 0} }

  .cs-cart { position: absolute; bottom: 8px; left: 50%; width: 320px; height: 260px; transform: translateX(-50%); z-index: 20; }
  .cs-cart svg { display: block; filter: drop-shadow(0 10px 26px rgba(0,0,0,.45)); }
  @keyframes cs-spring { 0%{transform:translateX(-50%) scale(1,1)} 30%{transform:translateX(-50%) scale(1.05,.92)} 60%{transform:translateX(-50%) scale(.98,1.04)} 100%{transform:translateX(-50%) scale(1,1)} }

  .cs-cards { position: absolute; inset: 0; z-index: 25; }
  .cs-card { position: absolute; width: 190px; will-change: transform; }
  .cs-card.landed { transition: top .5s cubic-bezier(.34,1.4,.5,1), opacity .4s, transform .4s; animation: cs-idle 4.5s ease-in-out infinite; animation-delay: var(--fd,0s); }
  .cs-card.leaving { opacity: 0 !important; transform: translateY(30px) scale(.9) !important; transition: opacity .45s ease, transform .45s ease; animation: none !important; pointer-events: none; }
  .cs-card-inner { display: flex; align-items: center; gap: 12px; background: #fff; border: 1px solid #E9EEF5; border-radius: 14px; padding: 12px 15px; box-shadow: 0 24px 48px -16px rgba(0,0,0,.55); }
  .cs-card-bar { width: 5px; height: 42px; border-radius: 4px; background: linear-gradient(180deg,#F97316,#FDBA74); flex-shrink: 0; }
  .cs-card-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .cs-card-tag { font-size: 10.5px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: #94A3B8; }
  .cs-card-val { font-family: var(--font-head); font-size: 17px; font-weight: 700; color: #0F172A; margin-top: 1px; }
  .cs-card-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
  @keyframes cs-idle { 0%,100%{margin-top:0} 50%{margin-top:-4px} }

  .cs-floats { position: absolute; inset: 0; z-index: 42; pointer-events: none; }
  .cs-burst { position: absolute; width: 0; height: 0; }
  .cs-burst i { position: absolute; width: 7px; height: 7px; border-radius: 50%; transform-origin: 0 0; animation: cs-spark .62s ease-out forwards; }
  @keyframes cs-spark { 0%{opacity:0; transform:rotate(var(--a)) translateX(6px) scale(.4)} 25%{opacity:1} 100%{opacity:0; transform:rotate(var(--a)) translateX(44px) scale(1.1)} }
  .cs-floatchip { position: absolute; font-family: var(--font-head); font-weight: 700; font-size: 15px; color: #22C55E; background: rgba(34,197,94,.14); border: 1px solid rgba(34,197,94,.4); padding: 3px 10px; border-radius: 999px; animation: cs-floatup 1.25s ease-out forwards; }
