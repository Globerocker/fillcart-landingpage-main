---
import type { LandingContent } from '../../i18n/types.ts';

interface Props {
  content: LandingContent;
}
const { content } = Astro.props;
const h = content.hero;
const base = content.homePath.replace(/\/$/, '');
const stageData = {
  deals: content.hero_deals,
  total: content.pipelineTotal,
  label: h.cartLabel,
  locale: content.lang === 'en' ? 'en-US' : 'de-DE',
};
---

<section class="hero">
  <div class="hero-glow hero-glow-a"></div>
  <div class="hero-glow hero-glow-b"></div>
  <div class="hero-mesh"></div>

  <div class="hero-inner">
    <div class="hero-copy">
      <div class="hero-badge">
        <span class="dot"></span>
        <span set:html={h.badge} />
      </div>
      <h1 class="hero-h1" set:html={h.headline} />
      <p class="hero-sub" set:html={h.sub} />
      <div class="hero-bullets">
        {h.bullets.map((b) => (
          <div class="hero-bullet">
            <span class="check">✓</span>
            <span set:html={b} />
          </div>
        ))}
      </div>
      <div class="hero-ctas">
        <a href={`${base}/#audit`} class="btn-primary fc-lift">{h.ctaPrimary}</a>
        <a href={`${base}/#rechner`} class="btn-ghost fc-lift">{h.ctaSecondary}</a>
      </div>
    </div>

    <div class="hero-stage-col">
      <div
        class="cart-stage"
        id="cart-stage"
        data-stage={JSON.stringify(stageData)}
        aria-hidden="true"
      >
        <!-- Static fallback (no-JS / pre-hydration): filled cart snapshot -->
        <div class="cart-stage-fallback">
          <div class="fb-counter">
            <div class="fb-label">{h.cartLabel}</div>
            <div class="fb-value">€ {new Intl.NumberFormat(content.lang === 'en' ? 'en-US' : 'de-DE').format(content.pipelineTotal)}</div>
            <div class="fb-bar"><span></span></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Trust bar -->
  <div class="trust">
    <div class="trust-inner">
      <span class="trust-label">{content.trust.label}</span>
      {content.trust.items.map((item, i) => (
        <>
          {i > 0 && <span class="trust-sep">|</span>}
          <span class="trust-item">{item}</span>
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .hero { background: #0b1b33; position: relative; overflow: hidden; }
  .hero-glow { position: absolute; pointer-events: none; }
  .hero-glow-a {
    top: -180px; right: -140px; width: 680px; height: 680px;
    background: radial-gradient(circle, rgba(249, 115, 22, 0.22), transparent 62%);
  }
  .hero-glow-b {
    bottom: -160px; left: -120px; width: 520px; height: 520px;
    background: radial-gradient(circle, rgba(34, 197, 94, 0.12), transparent 65%);
  }
  .hero-mesh {
    position: absolute; inset: 0; pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 54px 54px;
    -webkit-mask-image: radial-gradient(circle at 35% 45%, #000, transparent 78%);
    mask-image: radial-gradient(circle at 35% 45%, #000, transparent 78%);
  }
  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 76px 32px 40px;
    display: grid;
    grid-template-columns: 1.04fr 0.96fr;
    gap: 48px;
    align-items: center;
    position: relative;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(249, 115, 22, 0.12);
    border: 1px solid rgba(249, 115, 22, 0.35);
    color: #fdba74;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 7px 14px;
    border-radius: 999px;
  }
  .hero-badge .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: #f97316; display: inline-block;
    animation: fc-pulse 2s infinite;
  }

  .hero-h1 {
    font-family: var(--font-head);
    font-weight: 700;
    color: #fff;
    font-size: 56px;
    line-height: 1.04;
    letter-spacing: -0.025em;
    margin: 22px 0 0;
  }
  .hero-h1 :global(.muted) { color: #94a3b8; }
  .hero-h1 :global(.accent) { color: #f97316; }

  .hero-sub {
    color: #94a3b8;
    font-size: 18px;
    line-height: 1.6;
    max-width: 500px;
    margin: 22px 0 0;
  }
  .hero-sub :global(.hl) { color: #e2e8f0; font-weight: 500; }

  .hero-bullets {
    display: flex; flex-direction: column; gap: 11px;
    margin: 26px 0 0; max-width: 460px;
  }
  .hero-bullet {
    display: flex; align-items: center; gap: 11px;
    color: #cbd5e1; font-size: 15.5px;
  }
  .hero-bullet :global(b) { color: #fff; }
  .hero-bullet .check {
    flex-shrink: 0; width: 22px; height: 22px; border-radius: 6px;
    background: rgba(34, 197, 94, 0.16); color: #22c55e;
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 700;
  }

  .hero-ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }
  .btn-primary {
    background: #f97316; color: #fff; font-size: 16px; font-weight: 600;
    padding: 16px 26px; border-radius: 12px;
    box-shadow: 0 14px 30px -8px rgba(249, 115, 22, 0.6);
  }
  .btn-primary:hover {
    color: #fff; transform: translateY(-2px);
    box-shadow: 0 20px 38px -8px rgba(249, 115, 22, 0.7);
  }
  .btn-ghost {
    color: #e2e8f0; font-size: 16px; font-weight: 600;
    padding: 16px 22px; border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.16);
  }
  .btn-ghost:hover { color: #fff; border-color: rgba(255, 255, 255, 0.4); transform: translateY(-2px); }

  /* ---- Cart stage ---- */
  .hero-stage-col { display: flex; justify-content: center; }
  .cart-stage {
    position: relative;
    width: 100%;
    max-width: 470px;
    height: 476px;
    margin: 0 auto;
  }
  .cart-stage::before {
    content: '';
    position: absolute; left: 50%; bottom: 30px;
    width: 360px; height: 360px; transform: translateX(-50%);
    background: radial-gradient(circle, rgba(249, 115, 22, 0.2), transparent 62%);
    pointer-events: none;
  }
  .cart-stage-fallback {
    position: absolute; inset: 0;
    display: flex; align-items: flex-start; justify-content: center;
  }
  .fb-counter { text-align: center; width: 100%; }
  .fb-label {
    font-size: 12px; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: #64748b;
  }
  .fb-value {
    font-family: var(--font-head); font-size: 46px; font-weight: 700;
    color: #f97316; letter-spacing: -0.02em; line-height: 1.1; margin-top: 4px;
  }
  .fb-bar {
    width: 220px; height: 6px; border-radius: 999px;
    background: rgba(255, 255, 255, 0.1); margin: 12px auto 0; overflow: hidden;
  }
  .fb-bar span {
    display: block; width: 100%; height: 100%; border-radius: 999px;
    background: linear-gradient(90deg, #f97316, #22c55e);
  }

  /* ---- Trust bar ---- */
  .trust { border-top: 1px solid rgba(255, 255, 255, 0.08); position: relative; }
  .trust-inner {
    max-width: 1200px; margin: 0 auto; padding: 20px 32px;
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 12px 34px; justify-content: center;
  }
  .trust-label {
    color: #f97316; font-size: 12px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
  }
  .trust-item { color: #cbd5e1; font-size: 15px; font-weight: 600; }
  .trust-sep { color: #334155; }

  @media (max-width: 960px) {
    .hero-inner { grid-template-columns: 1fr; gap: 20px; padding: 48px 22px 32px; }
    .hero-h1 { font-size: 40px; }
    .hero-stage-col { order: -1; }
    .cart-stage { height: 420px; }
    .trust-inner { padding: 20px 22px; }
  }
  @media (max-width: 480px) {
    .hero-h1 { font-size: 33px; }
    .hero-sub { font-size: 16px; }
  }
</style>

<script>
  interface Deal { tag: string; value: number; dot: string; }
  interface StageData { deals: Deal[]; total: number; label: string; locale: string; }

  const stage = document.getElementById('cart-stage');
  if (stage) {
    const data = JSON.parse(stage.dataset.stage || '{}') as StageData;
    const { deals, total, label, locale } = data;
    const nf = new Intl.NumberFormat(locale);
    const fmt = (v: number) => nf.format(v);
    const eur = (v: number) => '€ ' + nf.format(Math.round(v));

    const CARD_W = 188;
    const SLOT_LEFT = 234 - CARD_W / 2; // 140
    const reduced =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Clear the static fallback; we render the live stage.
    stage.innerHTML = '';

    // Ambient glow (::before already provides the main one)
    // Counter block
    const counter = document.createElement('div');
    counter.className = 'cs-counter';
    counter.innerHTML =
      `<div class="cs-clabel">${label}</div>` +
      `<div class="cs-cvalue">${eur(0)}</div>` +
      `<div class="cs-cbar"><span></span></div>`;
    const valueEl = counter.querySelector('.cs-cvalue') as HTMLElement;
    const barEl = counter.querySelector('.cs-cbar span') as HTMLElement;

    // Cart
    const cartWrap = document.createElement('div');
    cartWrap.className = 'cs-cart';
    cartWrap.innerHTML = `
      <svg viewBox="0 0 320 258" width="320" height="258" style="overflow:visible">
        <g fill="none" stroke="#E2E8F0" stroke-width="11" stroke-linecap="round" stroke-linejoin="round">
          <path d="M40 44 H70 L96 60"></path>
          <path d="M86 76 H262"></path>
          <path d="M86 76 L110 196 H234 L262 76"></path>
        </g>
        <circle cx="124" cy="224" r="13" fill="#E2E8F0"></circle>
        <circle cx="216" cy="224" r="13" fill="#E2E8F0"></circle>
      </svg>`;

    const cardsLayer = document.createElement('div');
    cardsLayer.className = 'cs-cards';

    stage.append(counter, cartWrap, cardsLayer);

    const makeCard = (d: Deal): HTMLElement => {
      const el = document.createElement('div');
      el.className = 'cs-card';
      el.innerHTML = `
        <div class="cs-card-inner">
          <div class="cs-card-bar"></div>
          <div class="cs-card-body">
            <div class="cs-card-tag">${d.tag}</div>
            <div class="cs-card-val">+ €${fmt(d.value)}</div>
          </div>
          <div class="cs-card-dot" style="background:${d.dot};box-shadow:0 0 0 3px ${d.dot}22"></div>
        </div>`;
      return el;
    };

    // Paint the stack of landed cards (max 3).
    const paintLanded = (landed: Deal[]) => {
      cardsLayer.querySelectorAll('.cs-card.landed').forEach((n) => n.remove());
      landed.forEach((d, p) => {
        const depth = landed.length - 1 - p;
        const el = makeCard(d);
        el.classList.add('landed');
        el.style.left = SLOT_LEFT + 'px';
        el.style.top = 306 - depth * 24 + 'px';
        el.style.transform =
          `rotate(${(p % 2 === 0 ? -1 : 1) * 2}deg) scale(${1 - depth * 0.045})`;
        el.style.opacity = String(1 - depth * 0.16);
        el.style.zIndex = String(10 + p);
        cardsLayer.appendChild(el);
      });
    };

    const spark = () => {
      if (reduced) return;
      const s = document.createElement('div');
      s.className = 'cs-spark';
      [0, 60, 120, 180, 240, 300].forEach((a, i) => {
        const dot = document.createElement('div');
        dot.style.background = i % 2 ? '#22C55E' : '#F97316';
        dot.style.transform = `rotate(${a}deg) translateX(34px)`;
        s.appendChild(dot);
      });
      stage.appendChild(s);
      setTimeout(() => s.remove(), 600);
    };

    const springCart = () => {
      if (reduced) return;
      cartWrap.style.animation = 'none';
      // reflow to restart the animation
      void cartWrap.offsetWidth;
      cartWrap.style.animation = 'fc-spring .55s ease-out';
    };

    let pipe = 0;
    let raf = 0;
    const tweenPipe = (from: number, to: number, dur: number) => {
      cancelAnimationFrame(raf);
      const t0 = performance.now();
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / dur);
        const e = 1 - Math.pow(1 - p, 3);
        pipe = Math.round(from + (to - from) * e);
        valueEl.textContent = eur(pipe);
        barEl.style.width = Math.min(100, Math.round((pipe / total) * 100)) + '%';
        if (p < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };

    const timers: number[] = [];
    let landed: Deal[] = [];
    let cum = 0;

    const dropAt = (i: number) => {
      if (i >= deals.length) {
        timers.push(window.setTimeout(startLoop, 2100));
        return;
      }
      const d = deals[i];
      const fly = makeCard(d);
      fly.classList.add('flying');
      fly.style.left = SLOT_LEFT + 'px';
      fly.style.top = '306px';
      fly.style.zIndex = '30';
      fly.style.animation = 'fc-drop .76s cubic-bezier(.3,.7,.35,1) forwards';
      cardsLayer.appendChild(fly);

      timers.push(
        window.setTimeout(() => {
          fly.remove();
          const from = pipe;
          cum += d.value;
          tweenPipe(from, cum, 640);
          landed = [...landed, d].slice(-3);
          paintLanded(landed);
          springCart();
          spark();
          timers.push(window.setTimeout(() => dropAt(i + 1), 860));
        }, 760)
      );
    };

    function startLoop() {
      timers.forEach(clearTimeout);
      timers.length = 0;
      landed = [];
      cum = 0;
      pipe = 0;
      valueEl.textContent = eur(0);
      barEl.style.width = '0%';
      cardsLayer.innerHTML = '';
      dropAt(0);
    }

    if (reduced) {
      landed = deals.slice(-3);
      cum = total;
      pipe = total;
      valueEl.textContent = eur(total);
      barEl.style.width = '100%';
      paintLanded(landed);
    } else {
      startLoop();
    }
  }
</script>

<style is:global>
  /* Live-stage element styles (global because the script builds them). */
  .cs-counter { position: absolute; top: 0; left: 0; right: 0; text-align: center; z-index: 40; }
  .cs-clabel {
    font-size: 12px; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: #64748b;
  }
  .cs-cvalue {
    font-family: var(--font-head); font-size: 46px; font-weight: 700;
    color: #f97316; letter-spacing: -0.02em; line-height: 1.1; margin-top: 4px;
  }
  .cs-cbar {
    width: 220px; height: 6px; border-radius: 999px;
    background: rgba(255, 255, 255, 0.1); margin: 12px auto 0; overflow: hidden;
  }
  .cs-cbar span {
    display: block; width: 0%; height: 100%; border-radius: 999px;
    background: linear-gradient(90deg, #f97316, #22c55e);
    transition: width 0.5s ease-out;
  }
  .cs-cart {
    position: absolute; bottom: 6px; left: 50%; width: 320px; height: 258px;
    transform: translateX(-50%);
  }
  .cs-cart svg { display: block; }

  .cs-cards { position: absolute; inset: 0; }
  .cs-card { position: absolute; width: 188px; }
  .cs-card.landed {
    transition: top 0.5s cubic-bezier(0.34, 1.4, 0.5, 1), opacity 0.4s, transform 0.4s;
  }
  .cs-card-inner {
    background: #fff; border-radius: 14px; padding: 11px 15px;
    box-shadow: 0 22px 46px -14px rgba(0, 0, 0, 0.6);
    border: 1px solid #e9eef5; display: flex; align-items: center; gap: 12px;
  }
  .cs-card-bar { width: 5px; height: 40px; border-radius: 4px; background: #f97316; flex-shrink: 0; }
  .cs-card-body { flex: 1; min-width: 0; }
  .cs-card-tag {
    font-size: 10.5px; font-weight: 700; letter-spacing: 0.05em;
    text-transform: uppercase; color: #94a3b8;
  }
  .cs-card-val {
    font-size: 17px; font-weight: 700; color: #0f172a;
    font-family: var(--font-head); margin-top: 1px;
  }
  .cs-card-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }

  .cs-spark { position: absolute; left: 234px; top: 330px; width: 0; height: 0; z-index: 25; }
  .cs-spark > div {
    position: absolute; width: 7px; height: 7px; border-radius: 50%;
    transform-origin: 0 0; animation: fc-spark 0.55s ease-out forwards;
  }
</style>
