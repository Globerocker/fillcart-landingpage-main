---
import type { LandingContent } from '../../i18n/types.ts';
interface Props { content: LandingContent; }
const { content } = Astro.props;
const p = content.problem;
---

<section class="section problem">
  <div class="prob-dots"></div>
  <div class="prob-head" data-reveal>
    <div class="eyebrow">{p.eyebrow}</div>
    <h2 class="h2" set:html={p.headline} />
  </div>

  <div class="prob-stats">
    {p.stats.map((s) => (
      <div class="prob-card fc-lift" data-reveal>
        <div class="prob-num">{s.num}</div>
        <p>{s.text}</p>
      </div>
    ))}
  </div>

  <blockquote class="prob-quote" data-reveal>
    <div class="prob-quote-glow"></div>
    <p set:html={p.quote} />
  </blockquote>
</section>

<style>
  .problem { padding: 100px 32px; }
  .prob-dots {
    position: absolute; top: 40px; left: 50%; transform: translateX(-50%);
    width: 900px; height: 900px;
    background-image: radial-gradient(rgba(11, 27, 51, 0.05) 1.5px, transparent 1.5px);
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(circle, #000, transparent 70%);
    mask-image: radial-gradient(circle, #000, transparent 70%);
    pointer-events: none;
  }
  .prob-head { max-width: 760px; margin: 0 auto; text-align: center; position: relative; }

  .prob-stats {
    max-width: 940px; margin: 44px auto 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; position: relative;
  }
  .prob-card {
    background: #fff; border: 1px solid #e2e8f0; border-radius: 18px; padding: 26px 24px;
  }
  .prob-card:hover { transform: translateY(-4px); box-shadow: 0 24px 44px -20px rgba(11, 27, 51, 0.25); }
  .prob-num {
    font-family: var(--font-head); font-weight: 700; font-size: 40px;
    color: #f97316; line-height: 1;
  }
  .prob-card p { color: #475569; font-size: 15px; line-height: 1.55; margin: 10px 0 0; }

  .prob-quote {
    max-width: 840px; margin: 34px auto 0; padding: 34px 40px;
    background: #0b1b33; border-radius: 20px; border-left: 5px solid #f97316;
    position: relative; overflow: hidden;
  }
  .prob-quote-glow {
    position: absolute; top: -40px; right: -30px; width: 220px; height: 220px;
    background: radial-gradient(circle, rgba(249, 115, 22, 0.18), transparent 65%);
  }
  .prob-quote p {
    font-family: var(--font-head); font-weight: 600; font-size: 26px; line-height: 1.35;
    color: #fff; margin: 0; letter-spacing: -0.01em; position: relative;
  }
  .prob-quote :global(.accent) { color: #f97316; }

  @media (max-width: 820px) {
    .prob-stats { grid-template-columns: 1fr; max-width: 460px; }
    .prob-quote { padding: 28px 26px; }
    .prob-quote p { font-size: 22px; }
  }
</style>
