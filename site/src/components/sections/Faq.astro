---
import type { LandingContent } from '../../i18n/types.ts';
interface Props { content: LandingContent; }
const { content } = Astro.props;
const f = content.faq;
---

<section id="faq" class="section faq">
  <div class="faq-inner">
    <div class="faq-head" data-reveal>
      <div class="eyebrow">{f.eyebrow}</div>
      <h2 class="h2">{f.headline}</h2>
    </div>

    <div class="faq-list" data-reveal data-faq>
      {f.items.map((item, i) => (
        <div class={`faq-item ${i === 0 ? 'open' : ''}`} data-faq-item>
          <button class="faq-q" type="button" aria-expanded={i === 0 ? 'true' : 'false'} data-faq-btn>
            <span>{item.q}</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-a" data-faq-panel>
            <p>{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { padding: 100px 32px; }
  .faq-inner { max-width: 820px; margin: 0 auto; }
  .faq-head { text-align: center; }
  .faq-list { margin-top: 40px; display: flex; flex-direction: column; gap: 12px; }

  .faq-item { background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; }
  .faq-q {
    width: 100%; text-align: left; background: none; border: none; cursor: pointer;
    padding: 22px 26px; display: flex; align-items: center; justify-content: space-between;
    gap: 16px; font-family: inherit;
  }
  .faq-q > span:first-child {
    font-family: var(--font-head); font-weight: 600; font-size: 18px; color: #0b1b33;
  }
  .faq-icon {
    font-family: var(--font-head); font-size: 26px; font-weight: 400; color: #f97316;
    line-height: 1; transition: transform 0.3s; flex-shrink: 0;
  }
  .faq-item.open .faq-icon { transform: rotate(45deg); }

  .faq-a {
    overflow: hidden; max-height: 0; opacity: 0;
    transition: max-height 0.35s ease, opacity 0.3s;
  }
  .faq-item.open .faq-a { max-height: 320px; opacity: 1; }
  .faq-a p { color: #475569; font-size: 16px; line-height: 1.65; margin: 0; padding: 0 26px 24px; }

  @media (max-width: 480px) {
    .faq-q { padding: 18px 18px; }
    .faq-q > span:first-child { font-size: 16px; }
    .faq-a p { padding: 0 18px 20px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((list) => {
    const items = Array.from(list.querySelectorAll<HTMLElement>('[data-faq-item]'));
    items.forEach((item) => {
      const btn = item.querySelector<HTMLButtonElement>('[data-faq-btn]');
      btn?.addEventListener('click', () => {
        const isOpen = item.classList.contains('open');
        items.forEach((other) => {
          other.classList.remove('open');
          other.querySelector('[data-faq-btn]')?.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>
