---
import type { LandingContent } from '../../i18n/types.ts';
interface Props { content: LandingContent; }
const { content } = Astro.props;
const u = content.usp;
---

<section id="unterschied" class="section usp">
  <div class="usp-inner">
    <div class="usp-head" data-reveal>
      <div class="eyebrow">{u.eyebrow}</div>
      <h2 class="h2" set:html={u.headline} />
    </div>

    <div class="usp-table" data-reveal>
      <div class="usp-row usp-row-head">
        <div class="usp-cell usp-cell-blank"></div>
        <div class="usp-cell usp-cell-agency">{u.colAgency}</div>
        <div class="usp-cell usp-cell-fc-head">
          <img src="/assets/icon-white.png" alt="" width="22" height="22" />{u.colFillcart}
        </div>
      </div>
      {u.rows.map((row) => (
        <div class="usp-row">
          <div class="usp-cell usp-cell-label">{row[0]}</div>
          <div class="usp-cell usp-cell-b">{row[1]}</div>
          <div class="usp-cell usp-cell-fc">{row[2]}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .usp { padding: 100px 32px; }
  .usp-inner { max-width: 1000px; margin: 0 auto; }
  .usp-head { max-width: 760px; margin: 0 auto; text-align: center; }

  .usp-table {
    margin-top: 48px; border-radius: 22px; overflow: hidden;
    box-shadow: 0 40px 80px -30px rgba(11, 27, 51, 0.35); border: 1px solid #e2e8f0;
  }
  .usp-row { display: grid; grid-template-columns: 1.3fr 1fr 1fr; background: #fff; }
  .usp-row:not(.usp-row-head) { border-top: 1px solid #e2e8f0; }
  .usp-cell { display: flex; align-items: center; }

  .usp-row-head .usp-cell { padding: 22px 20px; }
  .usp-cell-blank { background: #0b1b33; }
  .usp-cell-agency {
    background: #0b1b33; justify-content: center; color: #94a3b8; font-weight: 600; font-size: 15px;
    border-left: 1px solid rgba(255, 255, 255, 0.08); text-align: center;
  }
  .usp-cell-fc-head {
    background: #f97316; justify-content: center; gap: 8px; color: #fff;
    font-family: var(--font-head); font-weight: 700; font-size: 17px;
  }
  .usp-cell-fc-head img { height: 22px; width: auto; }

  .usp-cell-label { padding: 20px 26px; font-weight: 600; font-size: 15.5px; color: #0b1b33; }
  .usp-cell-b {
    padding: 20px; font-size: 15px; color: #94a3b8; justify-content: center; text-align: center;
    border-left: 1px solid #eef2f6;
  }
  .usp-cell-fc {
    padding: 20px; font-size: 15px; color: #0b1b33; font-weight: 600; justify-content: center; text-align: center;
    background: rgba(249, 115, 22, 0.06); border-left: 1px solid rgba(249, 115, 22, 0.18);
  }

  @media (max-width: 620px) {
    .usp-row { grid-template-columns: 1fr 0.9fr 0.9fr; }
    .usp-cell-label { padding: 16px 14px; font-size: 13.5px; }
    .usp-cell-b, .usp-cell-fc { padding: 16px 10px; font-size: 13px; }
    .usp-cell-fc-head { font-size: 14px; }
    .usp-cell-agency { font-size: 13px; }
  }
</style>
