---
import type { LandingContent } from '../../i18n/types.ts';
import { SITE, INTEGRATIONS, HUBSPOT_FORM_READY, HUBSPOT_MEETING_READY, GOOGLE_CALENDAR_READY } from '../../config/site.ts';

interface Props { content: LandingContent; }
const { content } = Astro.props;
const cta = content.cta;
const form = cta.form;
const hs = INTEGRATIONS.hubspot;
const lf = INTEGRATIONS.leadForm;
const gcal = INTEGRATIONS.googleCalendar;
const ct = SITE.contact;
const isEn = content.lang === 'en';
const waText = encodeURIComponent(isEn ? ct.whatsappTextEn : ct.whatsappText);
const waHref = `${ct.whatsappHref}?text=${waText}`;

// Placeholder-calendar labels (only shown until the real HubSpot Meetings embed is wired).
const cal = {
  days: isEn ? ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'] : ['Mo', 'Di', 'Mi', 'Do', 'Fr'],
  pick: isEn ? 'Pick a time' : 'Termin wählen',
  week: isEn ? 'Week 28 · July' : 'KW 28 · Juli',
  free: isEn ? 'Free slots · Wed, Jul 10' : 'Freie Slots · Mi, 10. Juli',
  slots: ['09:00', '10:30', '13:00', '14:30', '16:00'],
  min: isEn ? '30 min' : '30 Min',
  oclock: isEn ? '' : ' Uhr',
};
---

<section id="audit" class="section finalcta">
  <div class="fcta-glow-a"></div>
  <div class="fcta-glow-b"></div>
  <div class="fcta-inner">
    <div class="fcta-head" data-reveal>
      <div class="eyebrow">{cta.eyebrow}</div>
      <h2 class="h2 on-dark">{cta.headline}</h2>
      <p class="fcta-sub">{cta.sub}</p>
    </div>

    <div class="fcta-grid">
      <!-- FORM -->
      <div class="fcta-formcard" data-reveal>
        {HUBSPOT_FORM_READY ? (
          <div id="hs-audit-form" data-hs-form data-portal={hs.portalId} data-form={hs.formId} data-region={hs.region}></div>
        ) : (
          <form
            class="fc-form"
            data-audit-form
            data-w3f-key={lf.web3formsKey}
            data-deliver-to={lf.deliverTo}
            data-subject={isEn ? 'New Fillcart audit request' : 'Neue Fillcart Audit-Anfrage'}
            data-sending={isEn ? 'Sending…' : 'Wird gesendet…'}
            novalidate
          >
            <h3 class="fc-form-title">{form.title}</h3>

            <label class="fc-label">
              <span>{form.name}</span>
              <input type="text" name="name" required placeholder={form.namePh} />
            </label>
            <label class="fc-label">
              <span>{form.email}</span>
              <input type="email" name="email" required placeholder={form.emailPh} />
            </label>
            <label class="fc-label">
              <span>{form.website}</span>
              <input type="text" name="website" required placeholder={form.websitePh} />
            </label>
            <label class="fc-label">
              <span>{form.budget}</span>
              <div class="fc-select-wrap">
                <select name="budget" required data-budget>
                  <option value="" disabled selected>{form.budgetPlaceholder}</option>
                  {form.budgetOptions.map((o) => <option value={o.value}>{o.label}</option>)}
                </select>
              </div>
            </label>

            <div class="fc-lowbudget" data-lowbudget hidden>{form.lowBudgetNotice}</div>

            <label class="fc-label">
              <span>{form.message}</span>
              <textarea name="message" rows="3" placeholder={form.messagePh}></textarea>
            </label>

            <button type="submit" class="fc-submit" data-submit>{form.submit}</button>
            <p class="fc-privacy">{form.privacyNote}</p>
          </form>
        )}

        <div class="fc-success" data-success hidden>
          <div class="fc-success-icon">✓</div>
          <h3>{form.successTitle}</h3>
          <p>{form.successText}</p>
        </div>
      </div>

      <!-- CALENDAR -->
      <div class="fcta-calcard" data-reveal>
        <div class="fcta-cal-top">
          <div>
            <div class="fcta-cal-title">{cta.calendar.title}</div>
            <div class="fcta-cal-sub">{cta.calendar.sub}</div>
          </div>
          <span class="fcta-cal-badge">{cta.calendar.badge}</span>
        </div>

        <div class="fcta-cal-contact">
          <a href={waHref} target="_blank" rel="noopener" class="fcta-wa">
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.9c0 1.76.46 3.45 1.34 4.95L2 22l5.3-1.39c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.9C21.95 6.45 17.5 2 12.04 2m0 18.15c-1.48 0-2.93-.4-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.39c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.16 8.16 0 0 1 2.41 5.82c0 4.54-3.69 8.23-8.23 8.23m4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.42-.14-.01-.31-.01-.48-.01a.92.92 0 0 0-.67.31c-.23.25-.88.86-.88 2.09s.9 2.43 1.03 2.6c.13.16 1.78 2.72 4.3 3.81.6.26 1.07.41 1.44.53.6.19 1.15.16 1.59.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29"/></svg>
            <span>WhatsApp</span>
          </a>
          <a href={ct.phoneHref} class="fcta-call">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M6.62 10.79a15.15 15.15 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1.02z"/></svg>
            <span>{ct.phone}</span>
          </a>
        </div>

        <div class="fcta-cal-embed">
          {GOOGLE_CALENDAR_READY ? (
            <iframe
              src={gcal.embedUrl}
              title={cta.calendar.title}
              loading="lazy"
              style="border:0;width:100%;height:100%;min-height:560px;display:block"
            ></iframe>
          ) : HUBSPOT_MEETING_READY ? (
            <div class="meetings-iframe-container" data-src={hs.meetingUrl}></div>
          ) : (
            <div class="cal-mock">
              <div class="cal-mock-top">
                <div class="cal-mock-title">{cal.pick}</div>
                <div class="cal-mock-week">{cal.week}</div>
              </div>
              <div class="cal-mock-days">
                {cal.days.map((d) => <div class="cal-mock-dayname">{d}</div>)}
              </div>
              <div class="cal-mock-dates">
                {[8, 9, 10, 11, 12].map((n, i) => (
                  <div class={`cal-mock-date ${i === 2 ? 'active' : ''}`}>{n}</div>
                ))}
              </div>
              <div class="cal-mock-freelabel">{cal.free}</div>
              <div class="cal-mock-slots">
                {cal.slots.map((sl, i) => (
                  <div class={`cal-mock-slot ${i === 1 ? 'active' : ''}`}>
                    <span>{sl}{cal.oclock}</span>
                    <span class="cal-mock-min">{cal.min}</span>
                  </div>
                ))}
              </div>
              <div class="cal-mock-note">{cta.calendar.placeholderNote}</div>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .finalcta { background: #0b1b33; padding: 100px 32px; }
  .fcta-glow-a {
    position: absolute; top: -120px; right: -100px; width: 560px; height: 560px;
    background: radial-gradient(circle, rgba(249, 115, 22, 0.18), transparent 62%); pointer-events: none;
  }
  .fcta-glow-b {
    position: absolute; bottom: -120px; left: -100px; width: 480px; height: 480px;
    background: radial-gradient(circle, rgba(34, 197, 94, 0.1), transparent 65%); pointer-events: none;
  }
  .fcta-inner { max-width: 1120px; margin: 0 auto; position: relative; }
  .fcta-head { max-width: 720px; text-align: center; margin: 0 auto; }
  .h2.on-dark { color: #fff; font-size: 42px; }
  .fcta-sub { color: #94a3b8; font-size: 18px; line-height: 1.6; margin: 18px 0 0; }

  .fcta-grid { margin-top: 44px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; }

  /* Form card */
  .fcta-formcard { background: #fff; border-radius: 22px; padding: 34px; box-shadow: 0 40px 80px -24px rgba(0, 0, 0, 0.5); }
  .fc-form-title { font-family: var(--font-head); font-weight: 700; font-size: 22px; color: #0b1b33; margin: 0 0 22px; }
  .fc-label { display: block; margin-bottom: 16px; }
  .fc-label > span { display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 7px; }
  .fc-label input, .fc-label textarea, .fc-label select {
    width: 100%; padding: 12px 14px; border-radius: 10px; border: 1px solid #cbd5e1;
    font-size: 15px; font-family: var(--font-body); color: #0f172a; background: #f8fafc;
    outline: none; box-sizing: border-box;
  }
  .fc-label input:focus, .fc-label textarea:focus, .fc-label select:focus { border-color: #f97316; }
  .fc-label textarea { resize: vertical; }
  .fc-select-wrap { position: relative; }
  .fc-select-wrap::after {
    content: ''; position: absolute; right: 15px; top: 50%; width: 8px; height: 8px;
    border-right: 2px solid #94a3b8; border-bottom: 2px solid #94a3b8;
    transform: translateY(-70%) rotate(45deg); pointer-events: none;
  }
  .fc-label select { appearance: none; -webkit-appearance: none; cursor: pointer; }

  .fc-lowbudget {
    background: #fff7ed; border: 1px solid #fed7aa; border-radius: 10px; padding: 12px 14px;
    margin-bottom: 16px; font-size: 13.5px; line-height: 1.55; color: #9a3412;
  }

  .fc-submit {
    width: 100%; padding: 15px; border-radius: 12px; border: none; background: #f97316;
    color: #fff; font-size: 16px; font-weight: 600; font-family: var(--font-body);
    cursor: pointer; margin-top: 4px; box-shadow: 0 12px 26px -8px rgba(249, 115, 22, 0.6);
    transition: background 0.2s, box-shadow 0.2s;
  }
  .fc-submit:disabled { background: #cbd5e1; box-shadow: none; cursor: not-allowed; }
  .fc-privacy { font-size: 12px; color: #94a3b8; text-align: center; margin: 14px 0 0; line-height: 1.5; }

  .fc-success { text-align: center; padding: 40px 10px; }
  .fc-success-icon {
    width: 56px; height: 56px; border-radius: 50%; background: #22c55e; color: #fff;
    display: flex; align-items: center; justify-content: center; font-size: 30px;
    margin: 0 auto 18px; font-family: var(--font-head);
  }
  .fc-success h3 { font-family: var(--font-head); font-size: 22px; color: #0b1b33; margin: 0; }
  .fc-success p { color: #475569; font-size: 15px; line-height: 1.6; margin-top: 12px; }

  /* Calendar card */
  .fcta-calcard {
    background: #12233f; border: 1px solid rgba(255, 255, 255, 0.09); border-radius: 22px;
    padding: 12px; display: flex; flex-direction: column;
  }
  .fcta-cal-top { padding: 18px 22px 14px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .fcta-cal-title { font-family: var(--font-head); font-weight: 600; font-size: 18px; color: #fff; }
  .fcta-cal-sub { color: #94a3b8; font-size: 14px; margin-top: 2px; }
  .fcta-cal-badge {
    font-size: 12px; font-weight: 700; color: #22c55e; background: rgba(34, 197, 94, 0.14);
    padding: 6px 12px; border-radius: 999px; white-space: nowrap;
  }
  .fcta-cal-contact {
    display: flex; gap: 10px; padding: 0 12px 12px;
  }
  .fcta-wa, .fcta-call {
    flex: 1; display: flex; align-items: center; justify-content: center; gap: 8px;
    padding: 11px 12px; border-radius: 12px; font-weight: 600; font-size: 14px;
    transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
  }
  .fcta-wa { background: #25d366; color: #052e16; box-shadow: 0 10px 22px -10px rgba(37, 211, 102, 0.7); }
  .fcta-wa:hover { color: #052e16; transform: translateY(-2px); box-shadow: 0 16px 28px -10px rgba(37, 211, 102, 0.8); }
  .fcta-call {
    background: rgba(255, 255, 255, 0.06); color: #e2e8f0; border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .fcta-call:hover { color: #fff; transform: translateY(-2px); background: rgba(255, 255, 255, 0.1); }
  .fcta-cal-embed {
    flex: 1; min-height: 520px; border-radius: 14px; overflow: hidden; background: #fff;
  }
  .meetings-iframe-container { width: 100%; min-height: 520px; }

  /* Calendar mock */
  .cal-mock { padding: 22px; font-family: var(--font-body); height: 100%; display: flex; flex-direction: column; }
  .cal-mock-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .cal-mock-title { font-family: var(--font-head); font-weight: 700; font-size: 17px; color: #0b1b33; }
  .cal-mock-week { font-size: 13px; color: #64748b; }
  .cal-mock-days, .cal-mock-dates { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
  .cal-mock-days { margin-bottom: 8px; }
  .cal-mock-dates { margin-bottom: 20px; }
  .cal-mock-dayname { text-align: center; font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; }
  .cal-mock-date {
    padding: 9px 0; text-align: center; border-radius: 8px; font-size: 13px; font-weight: 600;
    background: #f1f5f9; color: #94a3b8; border: 1px solid #e2e8f0;
  }
  .cal-mock-date.active { background: #0b1b33; color: #fff; border-color: #0b1b33; }
  .cal-mock-freelabel { font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 10px; }
  .cal-mock-slots { display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .cal-mock-slot {
    padding: 13px 16px; border-radius: 10px; border: 1px solid #e2e8f0; background: #fff;
    color: #334155; font-weight: 600; font-size: 14px;
    display: flex; justify-content: space-between; align-items: center; cursor: pointer;
  }
  .cal-mock-slot.active { border-color: #f97316; background: rgba(249, 115, 22, 0.06); color: #f97316; }
  .cal-mock-min { font-size: 12px; color: #94a3b8; }
  .cal-mock-slot.active .cal-mock-min { color: #f97316; }
  .cal-mock-note {
    margin-top: 16px; padding: 11px 14px; border-radius: 10px; background: #f1f5f9;
    color: #64748b; font-size: 11.5px; line-height: 1.5; text-align: center;
  }

  @media (max-width: 900px) {
    .fcta-grid { grid-template-columns: 1fr; }
    .h2.on-dark { font-size: 32px; }
  }
</style>

<script>
  // --- Custom form: budget qualifier + real lead delivery ---
  // Delivery order: Web3Forms (server-side email, no backend) → mailto fallback.
  // A lead is NEVER shown "success" unless it was actually sent or handed to a
  // mail client. See src/config/site.ts → INTEGRATIONS.leadForm.
  document.querySelectorAll<HTMLFormElement>('[data-audit-form]').forEach((formEl) => {
    const card = formEl.closest('.fcta-formcard');
    const budget = formEl.querySelector<HTMLSelectElement>('[data-budget]');
    const notice = formEl.querySelector<HTMLElement>('[data-lowbudget]');
    const submit = formEl.querySelector<HTMLButtonElement>('[data-submit]');
    const success = card?.querySelector<HTMLElement>('[data-success]');

    const w3fKey = formEl.dataset.w3fKey || '';
    const deliverTo = formEl.dataset.deliverTo || 'info@fillcart.de';
    const subject = formEl.dataset.subject || 'New audit request';
    const submitLabel = submit?.textContent || '';

    const sync = () => {
      const low = budget?.value === 'u5';
      if (notice) notice.hidden = !low;
      if (submit) submit.disabled = !!low;
    };
    budget?.addEventListener('change', sync);

    const fields = () => {
      const fd = new FormData(formEl);
      const budgetLabel =
        formEl.querySelector<HTMLSelectElement>('[data-budget]')?.selectedOptions[0]?.text || '';
      return {
        name: String(fd.get('name') || ''),
        email: String(fd.get('email') || ''),
        website: String(fd.get('website') || ''),
        budget: budgetLabel,
        message: String(fd.get('message') || ''),
      };
    };

    const showSuccess = () => {
      formEl.hidden = true;
      if (success) success.hidden = false;
    };

    // Last-resort: hand the lead to the visitor's mail client so it is never lost.
    const mailtoFallback = (f: ReturnType<typeof fields>) => {
      const body =
        `Name: ${f.name}\nE-Mail: ${f.email}\nWebsite: ${f.website}\n` +
        `Budget: ${f.budget}\n\n${f.message}`;
      window.location.href =
        `mailto:${deliverTo}?subject=${encodeURIComponent(subject)}` +
        `&body=${encodeURIComponent(body)}`;
      showSuccess();
    };

    formEl.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (budget?.value === 'u5') return;
      if (!formEl.checkValidity()) {
        formEl.reportValidity();
        return;
      }
      const f = fields();

      // No server-side key configured → mailto fallback (guaranteed delivery).
      if (!w3fKey) { mailtoFallback(f); return; }

      // Web3Forms: server-side email, no backend required.
      if (submit) { submit.disabled = true; submit.textContent = formEl.dataset.sending || 'Sending…'; }
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: w3fKey,
            subject,
            from_name: 'Fillcart Website',
            name: f.name,
            email: f.email,
            website: f.website,
            budget: f.budget,
            message: f.message,
          }),
        });
        if (res.ok) { showSuccess(); return; }
        throw new Error('web3forms ' + res.status);
      } catch {
        // Network/service failure → don't drop the lead, fall back to mailto.
        if (submit) { submit.disabled = false; submit.textContent = submitLabel; }
        mailtoFallback(f);
      }
    });
  });

  // --- Real HubSpot form embed (when portal + form ids are configured) ---
  const hsForm = document.querySelector<HTMLElement>('[data-hs-form]');
  if (hsForm) {
    const s = document.createElement('script');
    s.src = 'https://js.hsforms.net/forms/embed/v2.js';
    s.async = true;
    s.onload = () => {
      // @ts-expect-error - hbspt is injected by the embed script
      window.hbspt?.forms.create({
        portalId: hsForm.dataset.portal,
        formId: hsForm.dataset.form,
        region: hsForm.dataset.region,
        target: '#' + hsForm.id,
      });
    };
    document.body.appendChild(s);
  }

  // --- Real HubSpot meetings embed (when a meeting link is configured) ---
  const meeting = document.querySelector<HTMLElement>('.meetings-iframe-container[data-src]');
  if (meeting) {
    const s = document.createElement('script');
    s.src = 'https://static.hsappstatic.net/MeetingsEmbedCode/static-1.72/MeetingsEmbedCode.js';
    s.async = true;
    document.body.appendChild(s);
  }
</script>
