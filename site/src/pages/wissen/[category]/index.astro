---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { de } from '../../../i18n/de.ts';
import { SITE } from '../../../config/site.ts';
import { CATEGORIES, CATEGORY_ORDER, sortPosts, postsByCategory } from '../../../lib/blog.ts';

export async function getStaticPaths() {
  return CATEGORY_ORDER.map((key) => ({ params: { category: key } }));
}

const { category } = Astro.params;
const cat = CATEGORIES[category as keyof typeof CATEGORIES];
const posts = postsByCategory(sortPosts(await getCollection('blog')), cat.key);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${cat.label} — Fillcart Wissen`,
  description: cat.description,
  url: new URL(`/wissen/${cat.key}/`, SITE.baseUrl).href,
};
---

<BaseLayout
  lang="de"
  title={`${cat.label} für B2B — Guides & Best Practices | Fillcart`}
  description={cat.description}
  path={`/wissen/${cat.key}/`}
  altPath="/en/"
  schema={schema}
>
  <Header content={de} />

  <main>
    <section class="ch" style={`--accent:${cat.accent}`}>
      <div class="ch-glow"></div>
      <div class="ch-inner">
        <nav class="ch-crumbs"><a href="/wissen/">Wissen</a><span>›</span><span>{cat.label}</span></nav>
        <span class="ch-badge" style={`--accent:${cat.accent}`}>{cat.label}</span>
        <h1 class="ch-title">{cat.label}</h1>
        <p class="ch-sub">{cat.description}</p>
        <div class="ch-tabs">
          {CATEGORY_ORDER.map((k) => (
            <a href={`/wissen/${k}/`} class={`ch-tab ${k === cat.key ? 'active' : ''}`} style={`--accent:${CATEGORIES[k].accent}`}>{CATEGORIES[k].label}</a>
          ))}
        </div>
      </div>
    </section>

    <section class="ch-body">
      <div class="ch-body-inner">
        {posts.length > 0 ? (
          <div class="wgrid">{posts.map((p) => <ArticleCard entry={p} />)}</div>
        ) : (
          <p style="text-align:center;color:#64748B">Artikel folgen in Kürze.</p>
        )}
      </div>
    </section>
  </main>

  <Footer content={de} />
</BaseLayout>

<style>
  .ch { background: #0b1b33; position: relative; overflow: hidden; padding: 72px 32px 60px; }
  .ch-glow { position: absolute; top: -160px; right: -120px; width: 560px; height: 560px; background: radial-gradient(circle, color-mix(in srgb, var(--accent) 22%, transparent), transparent 64%); pointer-events: none; }
  .ch-inner { max-width: 1120px; margin: 0 auto; position: relative; }
  .ch-crumbs { display: flex; gap: 8px; align-items: center; color: #64748b; font-size: 13px; margin-bottom: 16px; }
  .ch-crumbs a { color: #94a3b8; }
  .ch-crumbs a:hover { color: #fff; }
  .ch-badge { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); padding: 5px 12px; border-radius: 999px; }
  .ch-title { font-family: var(--font-head); font-weight: 700; color: #fff; font-size: 44px; letter-spacing: -0.02em; margin: 14px 0 0; }
  .ch-sub { color: #94a3b8; font-size: 18px; line-height: 1.6; margin: 16px 0 0; max-width: 620px; }
  .ch-tabs { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .ch-tab { font-size: 14px; font-weight: 600; color: #cbd5e1; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.12); padding: 9px 16px; border-radius: 999px; }
  .ch-tab:hover { color: #fff; }
  .ch-tab.active { color: #fff; background: color-mix(in srgb, var(--accent) 22%, transparent); border-color: var(--accent); }

  .ch-body { padding: 52px 32px 80px; }
  .ch-body-inner { max-width: 1120px; margin: 0 auto; }
  .wgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  @media (max-width: 900px) { .wgrid { grid-template-columns: 1fr; } .ch-title { font-size: 34px; } }
</style>
