---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { sortPosts } from '../../../lib/blog.ts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const published = sortPosts(posts);
  return published.map((entry) => ({
    params: { category: entry.data.category, slug: entry.id.replace(/^.*\//, '') },
    props: { entry, allPosts: published },
  }));
}

const { entry, allPosts } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout entry={entry} headings={headings} allPosts={allPosts} bodyText={entry.body}>
  <Content />
</ArticleLayout>
