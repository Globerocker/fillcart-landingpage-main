---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { de } from '../../i18n/de.ts';
import { SITE } from '../../config/site.ts';
import { CATEGORIES, CATEGORY_ORDER, sortPosts, postsByCategory } from '../../lib/blog.ts';

const posts = sortPosts(await getCollection('blog'));
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.id !== featured?.id);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Fillcart Wissen',
  description: 'B2B-Wissen zu Google Ads, SEO & AEO und HubSpot.',
  url: new URL('/wissen/', SITE.baseUrl).href,
  publisher: { '@type': 'Organization', name: SITE.company.legalName },
};
---

<BaseLayout
  lang="de"
  title="Wissen: Google Ads, SEO & AEO, HubSpot für B2B | Fillcart"
  description="Tiefe, ehrliche Guides zu Google Ads, SEO & AEO (KI-Suche) und HubSpot — geschrieben für B2B-Marketer, die auf Pipeline optimieren."
  path="/wissen/"
  schema={schema}
>
  <Header content={de} />

  <main>
    <section class="wh">
      <div class="wh-glow"></div>
      <div class="wh-mesh"></div>
      <div class="wh-inner">
        <div class="eyebrow" style="color:#FDBA74">Wissen</div>
        <h1 class="wh-title">Kein Content-Marketing.<br>Ein Arbeitsbuch.</h1>
        <p class="wh-sub">Tiefe Guides zu Google Ads, SEO &amp; AEO und HubSpot — für B2B-Teams, die auf Pipeline optimieren statt auf Klicks. Ehrlich, mit Quellen, ohne Agentur-Blabla.</p>
        <div class="wh-cats">
          {CATEGORY_ORDER.map((key) => (
            <a href={`/wissen/${key}/`} class="wh-cat" style={`--accent:${CATEGORIES[key].accent}`}>
              <span class="wh-cat-label">{CATEGORIES[key].label}</span>
              <span class="wh-cat-count">{postsByCategory(posts, key).length} Artikel</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {featured && (
      <section class="wsec">
        <div class="wsec-inner">
          <div class="wfeat" data-reveal>
            <ArticleCard entry={featured} featured={true} />
          </div>
        </div>
      </section>
    )}

    {CATEGORY_ORDER.map((key) => {
      const catPosts = postsByCategory(rest, key);
      if (catPosts.length === 0) return null;
      return (
        <section class="wsec">
          <div class="wsec-inner">
            <div class="wsec-head">
              <div>
                <div class="eyebrow" style={`color:${CATEGORIES[key].accent}`}>{CATEGORIES[key].label}</div>
                <h2 class="wsec-title">{CATEGORIES[key].description}</h2>
              </div>
              <a href={`/wissen/${key}/`} class="wsec-all">Alle ansehen →</a>
            </div>
            <div class="wgrid">
              {catPosts.slice(0, 3).map((p) => <ArticleCard entry={p} />)}
            </div>
          </div>
        </section>
      );
    })}

    {posts.length === 0 && (
      <section class="wsec"><div class="wsec-inner"><p style="text-align:center;color:#64748B">Artikel folgen in Kürze.</p></div></section>
    )}
  </main>

  <Footer content={de} />
</BaseLayout>

<style>
  .wh { background: #0b1b33; position: relative; overflow: hidden; padding: 84px 32px 72px; }
  .wh-glow {
    position: absolute; top: -160px; right: -120px; width: 620px; height: 620px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.16), transparent 64%); pointer-events: none;
  }
  .wh-mesh {
    position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
    background-size: 54px 54px; -webkit-mask-image: radial-gradient(circle at 30% 40%, #000, transparent 78%); mask-image: radial-gradient(circle at 30% 40%, #000, transparent 78%);
  }
  .wh-inner { max-width: 900px; margin: 0 auto; position: relative; }
  .wh-title { font-family: var(--font-head); font-weight: 700; color: #fff; font-size: 50px; line-height: 1.06; letter-spacing: -0.025em; margin: 14px 0 0; }
  .wh-sub { color: #94a3b8; font-size: 18.5px; line-height: 1.6; margin: 20px 0 0; max-width: 640px; }
  .wh-cats { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .wh-cat {
    display: flex; flex-direction: column; gap: 2px;
    background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px; padding: 14px 20px; border-top: 3px solid var(--accent); transition: transform .25s, background .25s;
  }
  .wh-cat:hover { transform: translateY(-3px); background: rgba(255, 255, 255, 0.09); color: inherit; }
  .wh-cat-label { font-family: var(--font-head); font-weight: 600; font-size: 17px; color: #fff; }
  .wh-cat-count { font-size: 13px; color: #94a3b8; }

  .wsec { padding: 44px 32px; }
  .wsec:first-of-type { padding-top: 56px; }
  .wsec-inner { max-width: 1120px; margin: 0 auto; }
  .wsec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 26px; }
  .wsec-title { font-family: var(--font-head); font-weight: 700; font-size: 22px; line-height: 1.3; color: var(--navy); margin: 8px 0 0; max-width: 620px; }
  .wsec-all { font-weight: 600; font-size: 15px; white-space: nowrap; }
  .wgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .wfeat { display: block; }

  @media (max-width: 900px) { .wgrid { grid-template-columns: 1fr; } .wh-title { font-size: 38px; } }
</style>
