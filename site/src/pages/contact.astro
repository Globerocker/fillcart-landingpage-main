---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/pages/Contact.astro';
import { en } from '../i18n/en.ts';
import { breadcrumbSchema } from '../lib/seo.ts';
---
<BaseLayout lang="en" title={en.contact.meta.title} description={en.contact.meta.description} path="/contact" ogImage="/og/contact-en.png" schema={[breadcrumbSchema([{ name: 'Contact', path: '/contact' }])]}>
  <Contact lang="en" />
</BaseLayout>
