---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { de } from '../../i18n/de.ts';
import { SITE } from '../../config/site.ts';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((entry) => ({ params: { slug: entry.id.replace(/^.*\//, '') }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const accentHex = { orange: '#F97316', green: '#22C55E', sky: '#38BDF8' }[data.accent];
const url = `/referenzen/${entry.id.replace(/^.*\//, '')}/`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: data.publishDate.toISOString(),
  author: { '@type': 'Organization', name: SITE.company.legalName },
  articleSection: data.industry,
};
---

<BaseLayout lang="de" title={`${data.title} | Referenzen | Fillcart`} description={data.description} path={url} altPath="/en/" schema={schema}>
  <Header content={de} />

  <main class="cs">
    <section class="cs-hero" style={`--accent:${accentHex}`}>
      <div class="cs-hero-glow"></div>
      <div class="cs-hero-inner">
        <nav class="cs-crumbs"><a href="/referenzen/">Referenzen</a><span>›</span><span>{data.industry}</span></nav>
        <span class="cs-badge" style={`--accent:${accentHex}`}>{data.industry}</span>
        <h1 class="cs-title">{data.title}</h1>
        <p class="cs-client">{data.client}</p>
        {data.metrics.length > 0 && (
          <div class="cs-metrics">
            {data.metrics.map((m) => (
              <div class="cs-metric"><b style={`color:${accentHex}`}>{m.value}</b><span>{m.label}</span></div>
            ))}
          </div>
        )}
      </div>
    </section>

    <section class="cs-body">
      <article class="article-body cs-article">
        <Content />
      </article>

      <div class="cs-endcta">
        <div>
          <h3>Willst du wissen, was bei dir realistisch drin ist?</h3>
          <p>Wir rechnen im kostenlosen Audit mit deinen echten Zahlen — nicht mit Modellen.</p>
        </div>
        <a href="/#audit" class="cs-endcta-btn">Kostenlosen Audit sichern →</a>
      </div>
    </section>
  </main>

  <Footer content={de} />
</BaseLayout>

<style>
  .cs-hero { background: #0b1b33; position: relative; overflow: hidden; padding: 68px 32px 54px; }
  .cs-hero-glow { position: absolute; top: -140px; right: -110px; width: 520px; height: 520px; background: radial-gradient(circle, color-mix(in srgb, var(--accent) 22%, transparent), transparent 64%); pointer-events: none; }
  .cs-hero-inner { max-width: 820px; margin: 0 auto; position: relative; }
  .cs-crumbs { display: flex; gap: 8px; align-items: center; color: #64748b; font-size: 13px; margin-bottom: 16px; }
  .cs-crumbs a { color: #94a3b8; }
  .cs-crumbs a:hover { color: #fff; }
  .cs-badge { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); padding: 5px 12px; border-radius: 999px; }
  .cs-title { font-family: var(--font-head); font-weight: 700; color: #fff; font-size: 40px; line-height: 1.1; letter-spacing: -0.02em; margin: 14px 0 0; }
  .cs-client { color: #94a3b8; font-size: 16px; margin: 12px 0 0; }
  .cs-metrics { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .cs-metric { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); border-radius: 14px; padding: 16px 20px; display: flex; flex-direction: column; }
  .cs-metric b { font-family: var(--font-head); font-size: 30px; line-height: 1; }
  .cs-metric span { color: #94a3b8; font-size: 12.5px; margin-top: 6px; max-width: 150px; }

  .cs-body { padding: 52px 32px 84px; }
  .cs-article { max-width: 760px; margin: 0 auto; }
  .cs-article :global(blockquote) { font-family: var(--font-body) !important; font-size: 14px !important; font-weight: 400 !important; color: var(--slate-600) !important; background: var(--bg-alt); border-left: 4px solid var(--orange); padding: 14px 18px !important; border-radius: 10px; }

  .cs-endcta { max-width: 760px; margin: 44px auto 0; background: linear-gradient(135deg, #0B1B33, #12233f); border-radius: 20px; padding: 30px 34px; display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .cs-endcta h3 { font-family: var(--font-head); font-weight: 700; font-size: 21px; color: #fff; margin: 0; }
  .cs-endcta p { color: #94a3b8; font-size: 15px; margin: 8px 0 0; }
  .cs-endcta-btn { background: var(--orange); color: #fff !important; font-weight: 600; padding: 13px 22px; border-radius: 12px; white-space: nowrap; }
  .cs-endcta-btn:hover { background: var(--orange-hover); }

  @media (max-width: 700px) { .cs-title { font-size: 30px; } .cs-hero { padding: 48px 22px 40px; } .cs-body { padding: 36px 22px 64px; } }
</style>
