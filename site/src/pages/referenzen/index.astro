---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CaseCard from '../../components/CaseCard.astro';
import { de } from '../../i18n/de.ts';
import { SITE } from '../../config/site.ts';

const cases = (await getCollection('cases')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Referenzen & Cases — Fillcart',
  url: new URL('/referenzen/', SITE.baseUrl).href,
};
---

<BaseLayout
  lang="de"
  title="Referenzen & Cases: B2B Google Ads mit Pipeline-Fokus | Fillcart"
  description="Anonymisierte Fallbeispiele, wie wir Google Ads von Cost-per-Lead auf Pipeline-Value umgestellt haben — plus Referenzen und Zertifizierungen."
  path="/referenzen/"
  altPath="/en/"
  schema={schema}
>
  <Header content={de} />

  <main>
    <section class="fh">
      <div class="fh-glow"></div>
      <div class="fh-mesh"></div>
      <div class="fh-inner">
        <div class="eyebrow" style="color:#FDBA74">Referenzen</div>
        <h1 class="fh-title">Belegbar, nicht behauptet.</h1>
        <p class="fh-sub">Wie aus vollen Leadlisten planbare Pipeline wurde — anonymisierte Fallbeispiele, ehrlich gerechnet. Plus die Marken, mit denen Andre gearbeitet hat, und unsere Zertifizierungen.</p>
      </div>

      <div class="fh-logos">
        <span class="fh-logos-label">Zertifiziert &amp; Partner</span>
        <span class="fh-chip"><img src="/assets/google-partner.png" alt="Google Partner" style="height:30px" /></span>
        <span class="fh-chip"><img src="/assets/logos/hubspot-partner.svg" alt="HubSpot Solutions Partner" style="height:42px" /></span>
        <span class="fh-hs">20+ Zertifizierungen</span>
      </div>
    </section>

    <section class="fsec">
      <div class="fsec-inner">
        <div class="fsec-disclaimer">
          Echte Kunden aus DACH, USA, den Niederlanden und Australien — vom B2B-SaaS bis zum Custom-Home-Builder. <b>Konkrete Kennzahlen ergänzen wir pro Case nach Kundenfreigabe</b> direkt aus dem jeweiligen Konto; bis dahin zeigen wir Markt, Modell und Fokus statt geschönter Zahlen.
        </div>
        <div class="fgrid">
          {cases.map((c) => <CaseCard entry={c} />)}
        </div>

        <div class="fcta">
          <div>
            <h2>Dein Case ist der nächste.</h2>
            <p>Wir zeigen dir im kostenlosen Audit, was realistisch drin ist — mit deinen echten Konto- und CRM-Daten, nicht mit Modellrechnungen.</p>
          </div>
          <a href="/#audit" class="fcta-btn">Kostenlosen Audit sichern →</a>
        </div>
      </div>
    </section>
  </main>

  <Footer content={de} />
</BaseLayout>

<style>
  .fh { background: #0b1b33; position: relative; overflow: hidden; padding: 84px 32px 0; }
  .fh-glow { position: absolute; top: -160px; right: -120px; width: 600px; height: 600px; background: radial-gradient(circle, rgba(34,197,94,.14), transparent 64%); pointer-events: none; }
  .fh-mesh { position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px); background-size: 54px 54px; -webkit-mask-image: radial-gradient(circle at 30% 40%, #000, transparent 78%); mask-image: radial-gradient(circle at 30% 40%, #000, transparent 78%); }
  .fh-inner { max-width: 900px; margin: 0 auto; position: relative; }
  .fh-title { font-family: var(--font-head); font-weight: 700; color: #fff; font-size: 48px; line-height: 1.06; letter-spacing: -0.025em; margin: 14px 0 0; }
  .fh-sub { color: #94a3b8; font-size: 18.5px; line-height: 1.6; margin: 20px 0 0; max-width: 640px; }
  .fh-logos { max-width: 1120px; margin: 44px auto 0; padding: 24px 0 28px; border-top: 1px solid rgba(255,255,255,.08); display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 16px 34px; position: relative; }
  .fh-logos-label { color: #64748b; font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .fh-logo { font-family: var(--font-head); font-weight: 700; font-size: 21px; color: #cbd5e1; }
  .fh-chip { background: #fff; border-radius: 12px; padding: 10px 16px; display: inline-flex; align-items: center; box-shadow: 0 10px 30px -18px rgba(0,0,0,.6); }
  .fh-chip img { width: auto; display: block; }
  .fh-hs { border: 1px solid rgba(255,255,255,.2); border-radius: 10px; padding: 9px 15px; color: #e2e8f0; font-weight: 600; font-size: 14px; }

  .fsec { padding: 56px 32px 84px; }
  .fsec-inner { max-width: 1120px; margin: 0 auto; }
  .fsec-disclaimer { background: #fff; border: 1px solid var(--border); border-left: 4px solid var(--orange); border-radius: 12px; padding: 16px 20px; margin-bottom: 28px; font-size: 14px; line-height: 1.6; color: var(--slate-600); }
  .fgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

  .fcta { margin-top: 40px; background: linear-gradient(135deg, #0B1B33, #12233f); border-radius: 22px; padding: 36px 40px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .fcta h2 { font-family: var(--font-head); font-weight: 700; font-size: 26px; color: #fff; margin: 0; }
  .fcta p { color: #94a3b8; font-size: 16px; line-height: 1.55; margin: 10px 0 0; max-width: 560px; }
  .fcta-btn { background: var(--orange); color: #fff !important; font-weight: 600; font-size: 16px; padding: 15px 26px; border-radius: 12px; white-space: nowrap; box-shadow: 0 14px 30px -8px rgba(249,115,22,.6); }
  .fcta-btn:hover { background: var(--orange-hover); }

  @media (max-width: 900px) { .fgrid { grid-template-columns: 1fr; } .fh-title { font-size: 36px; } }
</style>
