---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { de } from '../i18n/de.ts';
import { organization } from '../lib/schema.ts';
import { SITE } from '../config/site.ts';

const c = SITE.company;
const schema = { '@context': 'https://schema.org', ...organization() };

const stats = [
  { value: '80.000 $', label: 'Ads-Budget/Monat über 3 Länder gemanagt', color: '#F97316' },
  { value: '+23 %', label: 'mehr SQLs in 6 Monaten', color: '#22C55E' },
  { value: '+88 %', label: 'organischer US-Traffic in 4 Monaten', color: '#22C55E' },
  { value: '20+', label: 'Zertifizierungen (Google, HubSpot)', color: '#38BDF8' },
];
const chips = ['Head of Marketing · Legal-Tech-SaaS', 'Head of SEO · Matrix42', 'HubSpot Consultant · B2B-Enterprise'];
---

<BaseLayout
  lang="de"
  title="Über Fillcart – Google Ads Agentur für B2B | FILLCART LLC"
  description="FILLCART LLC ist eine spezialisierte Google-Ads-Agentur für B2B im DACH-Raum und den USA. Ein Operator statt 40-Mann-Agentur: Andre Schüler."
  path="/ueber-fillcart"
  altPath="/en/about"
  schema={schema}
>
  <Header content={de} />

  <main>
    <!-- HERO -->
    <section class="ab-hero">
      <div class="ab-hero-glow"></div>
      <div class="ab-hero-mesh"></div>
      <div class="ab-hero-inner">
        <div class="ab-hero-copy">
          <div class="eyebrow" style="color:#FDBA74">Über uns</div>
          <h1 class="ab-title">Keine 40-Mann-Agentur.<br><span class="ab-accent">Ein Operator.</span></h1>
          <p class="ab-sub">Fillcart ist die spezialisierte Google-Ads-Agentur von <b>Andre Schüler</b> — für B2B im DACH-Raum und den USA. Kein Junior lernt an deinem Budget: Wer den Audit macht, baut auch deine Kampagnen und sitzt in jedem Call.</p>
          <ul class="ab-chips">
            {chips.map((chip) => <li>{chip}</li>)}
          </ul>
          <a href="/#audit" class="ab-cta">Kostenlosen Audit sichern →</a>
        </div>
        <div class="ab-portrait">
          <div class="ab-portrait-bg"></div>
          <img src="/assets/team/andre.png" alt="Andre Schüler" width="360" height="512" />
        </div>
      </div>

      <div class="ab-stats">
        {stats.map((s) => (
          <div class="ab-stat" style={`--c:${s.color}`}>
            <div class="ab-stat-val">{s.value}</div>
            <div class="ab-stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- STORY -->
    <section class="ab-body">
      <article class="prose">
        <p class="lead">
          FILLCART LLC ist eine spezialisierte Google-Ads-Agentur für B2B-Unternehmen im
          deutschsprachigen Raum und den USA. Gegründet 2023, geführt von Andre Schüler.
        </p>
        <p>
          Wir machen genau eine Sache — und die richtig: bezahlte Suchkampagnen, die messbar
          Pipeline erzeugen. Kampagnen-Management, Keyword-Optimierung, Conversion-Tracking und
          Reporting, direkt verbunden mit dem CRM unserer Kunden. So optimieren wir auf Umsatz,
          nicht auf Klickpreise.
        </p>

        <h2>Warum es uns gibt</h2>
        <p>
          Die meisten Agenturen optimieren auf Cost-per-Lead, weil sich das leicht messen und im
          Report hübsch darstellen lässt. Das Ergebnis: volle Leadlisten, leerer Vertrieb. Wir
          haben Fillcart gebaut, um die Reihenfolge umzudrehen — erst arbeiten, dann abrechnen, und
          immer auf die eine Zahl optimieren, die zählt: Pipeline-Value.
        </p>

        <h2>Wer dahinter steht</h2>
        <p>
          Andre Schüler war vorher Head of Marketing bei einer der führenden Legal-Tech-SaaS-Holdings
          Europas, Head of SEO bei Matrix42 und HubSpot Consultant für B2B-Enterprise-Kunden. Er hat
          Ads-Budgets über drei Länder gesteuert, ROAS hochgezogen und weiß, wie sich eine Kampagne
          im CRM anfühlt — nicht nur im Google-Ads-Dashboard.
        </p>

        <h2>Wie wir arbeiten — unsere interne Plattform</h2>
        <p>
          Um Kundenkampagnen konsistent und transparent zu steuern, betreiben wir eine interne,
          eigene Plattform — <strong>Fillcart Ads Manager</strong> — die mit der Google Ads API
          verbunden ist. Sie wird ausschließlich von unserem eigenen Team genutzt, um Kampagnen über
          die mit unserem Google-Ads-Manager-Konto (MCC) verknüpften Kundenkonten zu steuern und zu
          reporten. Sie ist kein Produkt, das wir verkaufen, lizenzieren oder Dritten zugänglich machen.
        </p>
        <p>Wobei die Plattform uns hilft:</p>
        <ul>
          <li><strong>Performance-Reporting</strong> — Kampagnen-, Anzeigengruppen-, Keyword- und Suchbegriff-Kennzahlen für wöchentliche und monatliche Kunden-Reports.</li>
          <li><strong>Kampagnen- &amp; Keyword-Management</strong> — Aufbau strukturierter Search- und Performance-Max-Kampagnen, Keyword-Pflege, Negativ-Listen.</li>
          <li><strong>Optimierung</strong> — Suchbegriff-Mining, Budget-Pacing und Gebotsanpassungen auf Basis echter Pipeline-Daten.</li>
          <li><strong>Change-Auditing</strong> — ein vollständiges Protokoll jeder Kontoänderung, für unsere QA und deine Transparenz.</li>
        </ul>
        <p>
          Jede Änderung wird von Menschen geprüft: Das Werkzeug erzeugt eine Vorschau, die unser
          Account-Manager bestätigt, bevor etwas angewendet wird; automatische Jobs sind rein lesend.
          Die Daten eines Kunden werden nur für dessen eigenes Konto verwendet — nie zwischen Kunden
          geteilt und nie weiterverkauft.
        </p>

        <div class="callout">
          Du willst wissen, was dein Google-Ads-Konto wirklich kann? Der Audit kostet 30 Minuten und
          null Euro. <a href="/#audit">Audit anfragen →</a>
        </div>

        <h2>Firmendaten</h2>
        <ul class="facts">
          <li><b>Firma</b><span>{c.legalName}</span></li>
          <li><b>Registrierung</b><span>{c.registeredIn} · Entity ID {c.entityId}</span></li>
          <li><b>Geschäftsadresse</b><span>{c.street}, {c.city}, {c.region} {c.postalCode}, {c.countryLabel}</span></li>
          <li><b>Branche</b><span>Advertising Agency (NAICS {c.naics})</span></li>
          <li><b>Kontakt</b><span><a href={`mailto:${c.email}`}>{c.email}</a> · <a href={SITE.contact.whatsappHref}>WhatsApp</a></span></li>
        </ul>
      </article>
    </section>
  </main>

  <Footer content={de} />
</BaseLayout>

<style>
  .ab-hero { background: #0b1b33; position: relative; overflow: hidden; padding: 72px 32px 0; }
  .ab-hero-glow { position: absolute; top: -160px; right: -120px; width: 620px; height: 620px; background: radial-gradient(circle, rgba(249,115,22,.18), transparent 64%); pointer-events: none; }
  .ab-hero-mesh { position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px); background-size: 54px 54px; -webkit-mask-image: radial-gradient(circle at 30% 40%, #000, transparent 78%); mask-image: radial-gradient(circle at 30% 40%, #000, transparent 78%); }
  .ab-hero-inner { max-width: 1120px; margin: 0 auto; position: relative; display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 48px; align-items: center; }
  .ab-title { font-family: var(--font-head); font-weight: 700; color: #fff; font-size: 48px; line-height: 1.08; letter-spacing: -0.025em; margin: 14px 0 0; }
  .ab-accent { color: #F97316; }
  .ab-sub { color: #94a3b8; font-size: 18px; line-height: 1.6; margin: 20px 0 0; max-width: 560px; }
  .ab-sub b { color: #e2e8f0; }
  .ab-chips { list-style: none; margin: 22px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 10px; }
  .ab-chips li { color: #cbd5e1; font-size: 13.5px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); padding: 6px 12px; border-radius: 999px; }
  .ab-cta { display: inline-block; margin-top: 26px; background: #F97316; color: #fff !important; font-weight: 600; font-size: 15px; padding: 14px 24px; border-radius: 12px; box-shadow: 0 14px 30px -8px rgba(249,115,22,.6); }
  .ab-cta:hover { background: var(--orange-hover); }
  .ab-portrait { position: relative; }
  .ab-portrait-bg { position: absolute; inset: auto 0 0 0; height: 80%; background: linear-gradient(180deg, rgba(249,115,22,.2), rgba(249,115,22,.02)); border-radius: 24px; }
  .ab-portrait img { position: relative; width: 100%; max-width: 340px; height: auto; display: block; margin: 0 auto; filter: drop-shadow(0 30px 50px rgba(0,0,0,.5)); }

  .ab-stats { max-width: 1120px; margin: 44px auto 0; position: relative; border-top: 1px solid rgba(255,255,255,.08); padding: 30px 0 40px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .ab-stat { border-top: 2px solid color-mix(in srgb, var(--c) 55%, transparent); padding-top: 14px; }
  .ab-stat-val { font-family: var(--font-head); font-weight: 700; font-size: 30px; color: var(--c); line-height: 1; }
  .ab-stat-label { color: #94a3b8; font-size: 13.5px; margin-top: 6px; }

  .ab-body { padding: 64px 32px 90px; }

  @media (max-width: 860px) {
    .ab-hero-inner { grid-template-columns: 1fr; gap: 24px; }
    .ab-portrait { max-width: 300px; margin: 0 auto; order: -1; }
    .ab-stats { grid-template-columns: 1fr 1fr; }
    .ab-title { font-size: 36px; }
    .ab-body { padding: 44px 22px 64px; }
  }
  @media (max-width: 480px) { .ab-stats { grid-template-columns: 1fr; } }
</style>
