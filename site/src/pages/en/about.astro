---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Subpage from '../../components/Subpage.astro';
import { en } from '../../i18n/en.ts';
import { organization } from '../../lib/schema.ts';
import { SITE } from '../../config/site.ts';

const c = SITE.company;
const schema = { '@context': 'https://schema.org', ...organization() };
---

<BaseLayout
  lang="en"
  title="About Fillcart – Google Ads agency for B2B | FILLCART LLC"
  description="FILLCART LLC is a specialized Google Ads agency for B2B companies in the US and the DACH region. Founded in 2023, led by Andre Schüler."
  path="/en/about"
  altPath="/ueber-fillcart"
  schema={schema}
>
  <Subpage
    content={en}
    eyebrow="About us"
    title="About Fillcart"
    intro="A specialized Google Ads agency for B2B — in the US and the German-speaking (DACH) region. Founded in 2023, led by Andre Schüler."
  >
    <p class="lead">
      FILLCART LLC is a specialized Google Ads agency for B2B companies in the US and the
      German-speaking (DACH) region. Founded in 2023, led by Andre Schüler.
    </p>
    <p>
      We do exactly one thing: paid search campaigns that measurably generate pipeline.
      Campaign management, keyword optimization, conversion tracking and reporting — connected to
      our clients' CRM, so we optimize for revenue instead of click prices.
    </p>

    <h2>Who's behind it</h2>
    <p>
      Fillcart is the agency of <strong>Andre Schüler</strong> — previously Head of Marketing at
      Europe's leading legal-tech SaaS holding, Head of SEO at Matrix42, HubSpot Consultant for
      B2B enterprise clients. No junior learns on your budget: the person who runs the audit also
      builds your campaigns and sits in every call.
    </p>
    <ul>
      <li>$80,000/month ad budget managed across three countries, with ROAS improved</li>
      <li>+23% SQLs in 6 months through cross-channel campaigns</li>
      <li>+88% organic US traffic in four months</li>
      <li>20+ certifications (Google Ads, HubSpot, Analytics)</li>
    </ul>
    <p><em>References: stp.one, Matrix42, CIXON.</em></p>

    <h2>How we work — our internal platform</h2>
    <p>
      To manage client campaigns consistently and transparently, we operate an internal, in-house
      platform — <strong>Fillcart Ads Manager</strong> — that connects to the Google Ads API. It is
      used exclusively by our own team to manage and report on campaigns across the client accounts
      linked to our Google Ads Manager Account (MCC). It is not a product we sell, license or open
      to third parties.
    </p>
    <p>What the platform helps us do:</p>
    <ul>
      <li><strong>Performance reporting</strong> — campaign, ad-group, keyword and search-term metrics for weekly and monthly client reports.</li>
      <li><strong>Campaign &amp; keyword management</strong> — build structured Search and Performance Max campaigns, manage keywords, maintain negative-keyword lists.</li>
      <li><strong>Optimization</strong> — search-term mining, budget pacing and bid adjustments based on real pipeline data.</li>
      <li><strong>Change auditing</strong> — a full log of every account change, for our QA and your transparency.</li>
    </ul>
    <p>
      Every change is human-reviewed: the tool produces a preview that our account manager confirms
      before anything is applied; automated jobs are read-only. Each client's data is used only for
      that client's own account — never shared between clients and never resold.
    </p>

    <h2>Company details</h2>
    <ul class="facts">
      <li><b>Company</b><span>{c.legalName}</span></li>
      <li><b>Registration</b><span>{c.registeredIn} · Entity ID {c.entityId}</span></li>
      <li><b>Business address</b><span>{c.street}, {c.city}, {c.region} {c.postalCode}, {c.countryLabel}</span></li>
      <li><b>Industry</b><span>Advertising Agency (NAICS {c.naics})</span></li>
      <li><b>Contact</b><span><a href={`mailto:${c.email}`}>{c.email}</a></span></li>
    </ul>

    <div class="callout">
      Want to know what your Google Ads account can really do? The audit takes 30 minutes and
      zero euros. <a href="/en/#audit">Request an audit →</a>
    </div>
  </Subpage>
</BaseLayout>
