---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { de } from '../../i18n/de.ts';
import { SITE } from '../../config/site.ts';
import { RESOURCES, ACCENT_HEX } from '../../data/resources.ts';

const featured = RESOURCES.find((r) => r.featured);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Ressourcen & Checklisten — Fillcart',
  url: new URL('/ressourcen/', SITE.baseUrl).href,
};
---

<BaseLayout
  lang="de"
  title="Ressourcen: Checklisten & Whitepaper für B2B-Werbung | Fillcart"
  description="Interaktive Checklisten zu Google Ads, AEO und HubSpot — direkt durchklicken, kein E-Mail-Zwang. Werkzeuge, die dir zeigen, wo Pipeline liegen bleibt."
  path="/ressourcen/"
  schema={schema}
>
  <Header content={de} />

  <main>
    <section class="rh">
      <div class="rh-glow"></div>
      <div class="rh-mesh"></div>
      <div class="rh-inner">
        <div class="eyebrow" style="color:#FDBA74">Ressourcen</div>
        <h1 class="rh-title">Werkzeuge, keine Lead-Magnet-Fallen.</h1>
        <p class="rh-sub">Interaktive Checklisten, die du sofort durchklickst — ohne dass wir vorher deine E-Mail als Geisel nehmen. Wenn zu viele Punkte offen bleiben, weißt du, warum wir reden sollten.</p>
      </div>
    </section>

    <section class="rsec">
      <div class="rsec-inner">
        <div class="rgrid">
          {RESOURCES.map((r) => (
            <a href={`/ressourcen/${r.slug}/`} class={`rcard fc-lift ${r.featured ? 'rcard-feat' : ''}`} style={`--accent:${ACCENT_HEX[r.accent]}`}>
              <div class="rcard-top">
                <span class="rcard-kick">{r.kicker}</span>
                <span class="rcard-kind">{r.kind === 'checklist' ? 'Interaktiv' : 'Whitepaper'}</span>
              </div>
              <h2 class="rcard-title">{r.title}</h2>
              <p class="rcard-desc">{r.description}</p>
              <span class="rcard-cta">Öffnen →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer content={de} />
</BaseLayout>

<style>
  .rh { background: #0b1b33; position: relative; overflow: hidden; padding: 84px 32px 68px; }
  .rh-glow { position: absolute; top: -160px; right: -120px; width: 600px; height: 600px; background: radial-gradient(circle, rgba(249,115,22,.18), transparent 64%); pointer-events: none; }
  .rh-mesh { position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px); background-size: 54px 54px; -webkit-mask-image: radial-gradient(circle at 30% 40%, #000, transparent 78%); mask-image: radial-gradient(circle at 30% 40%, #000, transparent 78%); }
  .rh-inner { max-width: 900px; margin: 0 auto; position: relative; }
  .rh-title { font-family: var(--font-head); font-weight: 700; color: #fff; font-size: 48px; line-height: 1.06; letter-spacing: -0.025em; margin: 14px 0 0; }
  .rh-sub { color: #94a3b8; font-size: 18.5px; line-height: 1.6; margin: 20px 0 0; max-width: 620px; }

  .rsec { padding: 56px 32px 80px; }
  .rsec-inner { max-width: 1120px; margin: 0 auto; }
  .rgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .rcard { display: flex; flex-direction: column; gap: 12px; background: #fff; border: 1px solid var(--border); border-radius: 18px; padding: 28px 26px; border-top: 3px solid var(--accent); }
  .rcard:hover { transform: translateY(-5px); box-shadow: 0 28px 50px -24px rgba(11,27,51,.28); border-color: var(--accent); color: inherit; }
  .rcard-feat { grid-column: span 3; flex-direction: row; align-items: center; gap: 32px; padding: 34px 34px; }
  .rcard-feat .rcard-title { font-size: 30px; }
  .rcard-feat .rcard-desc { max-width: 560px; }
  .rcard-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .rcard-kick { font-size: 11.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); }
  .rcard-kind { font-size: 11px; font-weight: 700; color: var(--slate-500); background: var(--bg-alt); padding: 4px 10px; border-radius: 999px; }
  .rcard-title { font-family: var(--font-head); font-weight: 700; font-size: 21px; line-height: 1.2; color: var(--navy); margin: 0; }
  .rcard-desc { color: var(--slate-600); font-size: 14.5px; line-height: 1.55; margin: 0; flex: 1; }
  .rcard-cta { color: var(--accent); font-weight: 600; font-size: 15px; margin-top: 4px; }
  .rcard-feat > div { flex: 1; }

  @media (max-width: 900px) {
    .rgrid { grid-template-columns: 1fr; }
    .rcard-feat { grid-column: auto; flex-direction: column; align-items: flex-start; }
    .rh-title { font-size: 36px; }
  }
</style>
