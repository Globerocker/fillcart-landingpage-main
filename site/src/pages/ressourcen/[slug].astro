---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import InteractiveChecklist from '../../components/InteractiveChecklist.astro';
import { de } from '../../i18n/de.ts';
import { SITE } from '../../config/site.ts';
import { RESOURCES, ACCENT_HEX } from '../../data/resources.ts';
import { CHECKLISTS } from '../../data/checklists.ts';

export async function getStaticPaths() {
  return RESOURCES.map((r) => ({ params: { slug: r.slug }, props: { resource: r } }));
}

const { resource } = Astro.props;
const accent = ACCENT_HEX[resource.accent];
const checklist = resource.checklistId ? CHECKLISTS[resource.checklistId] : undefined;
const url = `/ressourcen/${resource.slug}/`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: resource.title,
  description: resource.description,
  url: new URL(url, SITE.baseUrl).href,
};
---

<BaseLayout lang="de" title={`${resource.title} | Fillcart`} description={resource.description} path={url} schema={schema}>
  <Header content={de} />

  <main class="rd">
    <section class="rd-hero" style={`--accent:${accent}`}>
      <div class="rd-hero-glow"></div>
      <div class="rd-hero-inner">
        <nav class="rd-crumbs"><a href="/ressourcen/">Ressourcen</a><span>›</span><span>{resource.kicker}</span></nav>
        <span class="rd-badge" style={`--accent:${accent}`}>{resource.kicker}</span>
        <h1 class="rd-title">{resource.title}</h1>
        <p class="rd-intro">{resource.intro}</p>
      </div>
    </section>

    <section class="rd-body">
      <div class="rd-body-inner">
        {checklist && <InteractiveChecklist id={checklist.id} sections={checklist.sections} />}
      </div>
    </section>
  </main>

  <Footer content={de} />
</BaseLayout>

<style>
  .rd-hero { background: #0b1b33; position: relative; overflow: hidden; padding: 68px 32px 52px; }
  .rd-hero-glow { position: absolute; top: -140px; right: -110px; width: 520px; height: 520px; background: radial-gradient(circle, color-mix(in srgb, var(--accent) 22%, transparent), transparent 64%); pointer-events: none; }
  .rd-hero-inner { max-width: 820px; margin: 0 auto; position: relative; }
  .rd-crumbs { display: flex; gap: 8px; align-items: center; color: #64748b; font-size: 13px; margin-bottom: 16px; }
  .rd-crumbs a { color: #94a3b8; }
  .rd-crumbs a:hover { color: #fff; }
  .rd-badge { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); padding: 5px 12px; border-radius: 999px; }
  .rd-title { font-family: var(--font-head); font-weight: 700; color: #fff; font-size: 40px; line-height: 1.1; letter-spacing: -0.02em; margin: 14px 0 0; }
  .rd-intro { color: #94a3b8; font-size: 17px; line-height: 1.65; margin: 18px 0 0; }

  .rd-body { padding: 44px 32px 84px; }
  .rd-body-inner { max-width: 820px; margin: 0 auto; }

  @media (max-width: 700px) { .rd-title { font-size: 30px; } .rd-hero { padding: 48px 22px 40px; } .rd-body { padding: 32px 22px 64px; } }
</style>
