---
import BaseLayout from '../layouts/BaseLayout.astro';
import Subpage from '../components/Subpage.astro';
import { de } from '../i18n/de.ts';
import { SITE } from '../config/site.ts';

const c = SITE.company;
---

<BaseLayout
  lang="de"
  title="Impressum | FILLCART LLC"
  description="Impressum und Anbieterkennzeichnung der FILLCART LLC gemäß § 5 DDG."
  path="/impressum"
  altPath="/en/legal-notice"
>
  <Subpage content={de} eyebrow="Rechtliches" title="Impressum">
    <div class="callout">
      <strong>Hinweis:</strong> Dies ist ein Entwurf und stellt keine Rechtsberatung dar.
      Als US-LLC mit Ausrichtung auf den deutschen Markt greift die Impressumspflicht nach § 5 DDG
      durch die Marktausrichtung. Bitte vor Livegang anwaltlich bzw. über einen Dienst wie eRecht24 prüfen lassen.
    </div>

    <h2>Angaben gemäß § 5 DDG</h2>
    <div class="addr">
      {c.legalName}<br />
      {c.street}<br />
      {c.city}, {c.region} {c.postalCode}, {c.countryLabel}
    </div>

    <h3>Vertreten durch</h3>
    <p>{c.managingMember} (Managing Member)</p>

    <h3>Kontakt</h3>
    <p>E-Mail: <a href={`mailto:${c.email}`}>{c.email}</a></p>

    <h3>Registereintrag</h3>
    <p>Registriert: {c.registeredIn} — Entity ID {c.entityId}</p>

    <h3>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h3>
    <p>{c.managingMember} (Anschrift wie oben)</p>

    <h2>EU-Streitschlichtung</h2>
    <p>
      Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit:
      <a href="https://ec.europa.eu/consumers/odr/" target="_blank" rel="noopener">https://ec.europa.eu/consumers/odr/</a>.
      Unsere E-Mail-Adresse findest du oben.
    </p>
    <h3>Verbraucherstreitbeilegung / Universalschlichtungsstelle</h3>
    <p>
      Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer
      Verbraucherschlichtungsstelle teilzunehmen.
    </p>
  </Subpage>
</BaseLayout>
